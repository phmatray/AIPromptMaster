{
  "name": "ai-prompt-manager",
  "version": "1.0.0",
  "description": "AI Prompt Manager - Blazor Server Application",
  "scripts": {
    "build-css": "tailwindcss -i ./wwwroot/app.css -o ./wwwroot/dist/app.css",
    "build-css-watch": "tailwindcss -i ./wwwroot/app.css -o ./wwwroot/dist/app.css --watch",
    "build-css-prod": "tailwindcss -i ./wwwroot/app.css -o ./wwwroot/dist/app.css --minify"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}

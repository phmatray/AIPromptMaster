{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=promptmanager.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "MaxDatabaseSize": 104857600,
    "WarningThreshold": 83886080,
    "MaxPromptsPerUser": 10000,
    "MaxTagsTotal": 5000,
    "MaxPromptSize": 102400,
    "CleanupIntervalDays": 30,
    "AutoCleanupEnabled": true
  },
  "RateLimit": {
    "WindowDurationHours": 1,
    "CleanupIntervalMinutes": 15,
    "MaxAttemptsPerHour": {
      "Default": 10,
      "Login": 5,
      "PasswordReset": 3,
      "Registration": 5,
      "ChangePassword": 10,
      "TwoFactorAuth": 5,
      "AccountRecovery": 3,
      "EmailVerification": 5,
      "ApiAccess": 100
    }
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "Username": "",
    "Password": "",
    "FromEmail": "noreply@aipromptmanager.com",
    "FromName": "AI Prompt Manager"
  },
  "AppSettings": {
    "BaseUrl": "https://your-production-domain.com"
  }
}

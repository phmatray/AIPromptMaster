@page "/Account/ResetPassword"
@using System.ComponentModel.DataAnnotations
@using System.Text.Json
@using AIPromptManager.Models
@using AIPromptManager.Components.Shared
@inject HttpClient HttpClient
@inject NavigationManager Navigation
@inject ILogger<ResetPassword> Logger

<PageTitle>Reset Password</PageTitle>

<div class="min-h-screen bg-gray-50 flex flex-col justify-center py-12 sm:px-6 lg:px-8">
    <div class="sm:mx-auto sm:w-full sm:max-w-md">
        <!-- Logo/Brand -->
        <div class="flex justify-center">
            <i class="fas fa-shield-alt fa-3x text-blue-600" aria-hidden="true"></i>
        </div>
        <h2 class="mt-6 text-center text-3xl font-bold tracking-tight text-gray-900">
            Set new password
        </h2>
        <p class="mt-2 text-center text-sm text-gray-600">
            Enter your new password below
        </p>
    </div>

    <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
        <div class="card">
            <div class="card-body">
                <StatusMessage Message="@_statusMessage" />

                @if (!_isValidating && !_passwordReset && _isValidToken)
                {
                    <EditForm Model="Input" OnValidSubmit="OnValidSubmitAsync" FormName="reset-password">
                        <DataAnnotationsValidator />
                        
                        <div class="space-y-6">
                            <!-- Email Display (read-only) -->
                            <div>
                                <label class="form-label">
                                    <i class="fas fa-envelope mr-2 text-gray-400" aria-hidden="true"></i>
                                    Email address
                                </label>
                                <div class="form-input bg-gray-50 text-gray-600 cursor-not-allowed">
                                    @_email
                                </div>
                            </div>

                            <!-- New Password Field -->
                            <div>
                                <label for="new-password" class="form-label">
                                    <i class="fas fa-lock mr-2 text-gray-400" aria-hidden="true"></i>
                                    New password
                                </label>
                                <InputText @bind-Value="Input.NewPassword" 
                                          @oninput="OnPasswordInput"
                                          id="new-password" 
                                          type="password"
                                          class="form-input" 
                                          autocomplete="new-password" 
                                          aria-required="true" 
                                          placeholder="Enter your new password"
                                          disabled="@_isLoading" />
                                <ValidationMessage For="() => Input.NewPassword" class="validation-message" />
                                
                                <!-- Password strength indicator -->
                                @if (!string.IsNullOrEmpty(Input.NewPassword))
                                {
                                    <PasswordStrengthIndicator Password="@Input.NewPassword" ShowRequirements="true" />
                                }
                            </div>

                            <!-- Confirm Password Field -->
                            <div>
                                <label for="confirm-password" class="form-label">
                                    <i class="fas fa-check-double mr-2 text-gray-400" aria-hidden="true"></i>
                                    Confirm password
                                </label>
                                <InputText @bind-Value="Input.ConfirmPassword" 
                                          id="confirm-password" 
                                          type="password"
                                          class="form-input" 
                                          autocomplete="new-password" 
                                          aria-required="true" 
                                          placeholder="Confirm your new password"
                                          disabled="@_isLoading" />
                                <ValidationMessage For="() => Input.ConfirmPassword" class="validation-message" />
                            </div>

                            <!-- Submit button -->
                            <div>
                                <button type="submit" 
                                        disabled="@(_isLoading || !IsFormValid())"
                                        class="btn-primary w-full @((_isLoading || !IsFormValid()) ? "opacity-50 cursor-not-allowed" : "")">
                                    @if (_isLoading)
                                    {
                                        <i class="fas fa-spinner fa-spin mr-2" aria-hidden="true"></i>
                                        <span>Updating password...</span>
                                    }
                                    else
                                    {
                                        <i class="fas fa-key mr-2" aria-hidden="true"></i>
                                        <span>Update password</span>
                                    }
                                </button>
                            </div>
                        </div>
                    </EditForm>
                }
                else if (_isValidating)
                {
                    <div class="text-center py-8">
                        <i class="fas fa-spinner fa-spin fa-3x text-blue-600 mb-4" aria-hidden="true"></i>
                        <p class="text-sm text-gray-600">Validating your reset token...</p>
                    </div>
                }
                else if (_passwordReset)
                {
                    <div class="text-center">
                        <div class="mx-auto flex items-center justify-center h-16 w-16 rounded-full bg-green-100 mb-4">
                            <i class="fas fa-check text-green-600 text-2xl" aria-hidden="true"></i>
                        </div>
                        <h3 class="text-lg font-medium text-gray-900 mb-2">Password updated successfully</h3>
                        <p class="text-sm text-gray-600 mb-6">
                            Your password has been reset. You can now sign in with your new password.
                        </p>
                        <a href="Account/Login" 
                           class="btn-primary w-full">
                            <i class="fas fa-sign-in-alt mr-2" aria-hidden="true"></i>
                            Sign in
                        </a>
                    </div>
                }
                else if (!_isValidToken)
                {
                    <div class="text-center">
                        <div class="mx-auto flex items-center justify-center h-16 w-16 rounded-full bg-red-100 mb-4">
                            <i class="fas fa-exclamation-triangle text-red-600 text-2xl" aria-hidden="true"></i>
                        </div>
                        <h3 class="text-lg font-medium text-gray-900 mb-2">Invalid or expired link</h3>
                        <p class="text-sm text-gray-600 mb-6">
                            This password reset link is invalid or has expired. Please request a new one.
                        </p>
                        <div class="space-y-3">
                            <a href="Account/ForgotPassword" 
                               class="btn-primary w-full">
                                <i class="fas fa-key mr-2" aria-hidden="true"></i>
                                Request new reset link
                            </a>
                            <a href="Account/Login" 
                               class="block text-center text-sm text-blue-600 hover:text-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 rounded-md px-1">
                                Back to sign in
                            </a>
                        </div>
                    </div>
                }

                <!-- Security note -->
                @if (!_isValidating && !_passwordReset && _isValidToken)
                {
                    <div class="mt-6 p-3 bg-blue-50 border border-blue-200 rounded-lg">
                        <div class="flex items-start">
                            <i class="fas fa-info-circle text-blue-500 mt-0.5 mr-2 flex-shrink-0" aria-hidden="true"></i>
                            <div class="text-xs text-blue-700">
                                <p class="font-medium mb-1">Security tip:</p>
                                <p>Choose a strong password with at least 8 characters, including uppercase, lowercase, numbers, and special characters.</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private bool _isLoading;
    private bool _isValidating = true;
    private bool _passwordReset;
    private bool _isValidToken;
    private string? _statusMessage;
    private string _email = string.Empty;
    private string _token = string.Empty;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    [SupplyParameterFromQuery]
    private string? Email { get; set; }

    [SupplyParameterFromQuery]
    private string? Token { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _email = Email ?? string.Empty;
        _token = Token ?? string.Empty;

        if (string.IsNullOrEmpty(_email) || string.IsNullOrEmpty(_token))
        {
            _isValidating = false;
            _isValidToken = false;
            _statusMessage = "Error: Invalid reset link. Please request a new password reset.";
            return;
        }

        Input.Email = _email;
        await ValidateResetTokenAsync();
    }

    private async Task ValidateResetTokenAsync()
    {
        try
        {
            var response = await HttpClient.GetAsync($"api/passwordreset/validate?email={Uri.EscapeDataString(_email)}&token={Uri.EscapeDataString(_token)}");
            
            if (response.IsSuccessStatusCode)
            {
                var content = await response.Content.ReadAsStringAsync();
                var result = JsonSerializer.Deserialize<JsonElement>(content);
                
                _isValidToken = result.TryGetProperty("valid", out var validProperty) && validProperty.GetBoolean();
            }
            else
            {
                _isValidToken = false;
            }

            if (!_isValidToken)
            {
                _statusMessage = "Error: This password reset link is invalid or has expired.";
                Logger.LogWarning("Invalid reset token validation for email: {Email}", _email);
            }
        }
        catch (Exception ex)
        {
            _isValidToken = false;
            _statusMessage = "Error: Unable to validate reset token. Please try again.";
            Logger.LogError(ex, "Exception during reset token validation for email: {Email}", _email);
        }
        finally
        {
            _isValidating = false;
            StateHasChanged();
        }
    }

    private async Task OnValidSubmitAsync()
    {
        _isLoading = true;
        _statusMessage = null;
        StateHasChanged();

        try
        {
            var resetModel = new PasswordResetModel
            {
                Email = Input.Email,
                Token = _token,
                NewPassword = Input.NewPassword,
                ConfirmPassword = Input.ConfirmPassword
            };

            var json = JsonSerializer.Serialize(resetModel);
            var content = new StringContent(json, System.Text.Encoding.UTF8, "application/json");

            var response = await HttpClient.PostAsync("api/passwordreset/reset", content);

            if (response.IsSuccessStatusCode)
            {
                _passwordReset = true;
                Logger.LogInformation("Password reset successful for email: {Email}", Input.Email);
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                try
                {
                    var errorResponse = JsonSerializer.Deserialize<JsonElement>(errorContent);
                    if (errorResponse.TryGetProperty("message", out var message))
                    {
                        _statusMessage = $"Error: {message.GetString()}";
                    }
                    else
                    {
                        _statusMessage = "Error: Unable to reset password. Please try again.";
                    }
                }
                catch
                {
                    _statusMessage = "Error: Unable to reset password. Please try again.";
                }
                
                Logger.LogError("Password reset failed with status: {StatusCode} for email: {Email}", 
                    response.StatusCode, Input.Email);
            }
        }
        catch (Exception ex)
        {
            _statusMessage = "Error: An unexpected error occurred. Please try again.";
            Logger.LogError(ex, "Exception occurred during password reset for email: {Email}", Input.Email);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private void OnPasswordInput(ChangeEventArgs e)
    {
        Input.NewPassword = e.Value?.ToString() ?? string.Empty;
        StateHasChanged();
    }

    private bool IsFormValid()
    {
        return !string.IsNullOrEmpty(Input.NewPassword) &&
               !string.IsNullOrEmpty(Input.ConfirmPassword) &&
               Input.NewPassword == Input.ConfirmPassword &&
               Input.NewPassword.Length >= 8;
    }

    private sealed class InputModel
    {
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password is required")]
        [StringLength(100, MinimumLength = 8, ErrorMessage = "Password must be between 8 and 100 characters")]
        [RegularExpression(@"^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[\W_]).{8,}$", 
            ErrorMessage = "Password must contain at least one lowercase letter, one uppercase letter, one digit, and one special character")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password confirmation is required")]
        [Compare("NewPassword", ErrorMessage = "The password and confirmation password do not match")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
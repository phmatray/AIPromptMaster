@page "/Account/ForgotPassword"
@using System.ComponentModel.DataAnnotations
@using System.Text.Json
@using AIPromptManager.Models
@inject HttpClient HttpClient
@inject NavigationManager Navigation
@inject ILogger<ForgotPassword> Logger

<PageTitle>Forgot Password</PageTitle>

<div class="min-h-screen bg-gray-50 flex flex-col justify-center py-12 sm:px-6 lg:px-8">
    <div class="sm:mx-auto sm:w-full sm:max-w-md">
        <!-- Logo/Brand -->
        <div class="flex justify-center">
            <i class="fas fa-key fa-3x text-blue-600" aria-hidden="true"></i>
        </div>
        <h2 class="mt-6 text-center text-3xl font-bold tracking-tight text-gray-900">
            Reset your password
        </h2>
        <p class="mt-2 text-center text-sm text-gray-600">
            Remember your password?
            <a href="Account/Login" class="font-medium text-blue-600 hover:text-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 rounded-md px-1">
                Sign in
            </a>
        </p>
    </div>

    <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
        <div class="card">
            <div class="card-body">
                <StatusMessage Message="@_statusMessage" />

                @if (!_emailSent)
                {
                    <p class="text-sm text-gray-600 mb-6">
                        Enter your email address and we'll send you a link to reset your password.
                    </p>

                    <EditForm Model="Input" OnValidSubmit="OnValidSubmitAsync" FormName="forgot-password">
                        <DataAnnotationsValidator />
                        
                        <div class="space-y-6">
                            <!-- Email Field -->
                            <div>
                                <label for="email" class="form-label">
                                    <i class="fas fa-envelope mr-2 text-gray-400" aria-hidden="true"></i>
                                    Email address
                                </label>
                                <InputText @bind-Value="Input.Email" 
                                          id="email" 
                                          class="form-input" 
                                          autocomplete="email" 
                                          aria-required="true" 
                                          placeholder="Enter your email address"
                                          disabled="@_isLoading" />
                                <ValidationMessage For="() => Input.Email" class="validation-message" />
                            </div>

                            <!-- Submit button -->
                            <div>
                                <button type="submit" 
                                        disabled="@_isLoading"
                                        class="btn-primary w-full @(_isLoading ? "opacity-50 cursor-not-allowed" : "")">
                                    @if (_isLoading)
                                    {
                                        <i class="fas fa-spinner fa-spin mr-2" aria-hidden="true"></i>
                                        <span>Sending...</span>
                                    }
                                    else
                                    {
                                        <i class="fas fa-paper-plane mr-2" aria-hidden="true"></i>
                                        <span>Send reset link</span>
                                    }
                                </button>
                            </div>
                        </div>
                    </EditForm>
                }
                else
                {
                    <div class="text-center">
                        <div class="mx-auto flex items-center justify-center h-16 w-16 rounded-full bg-green-100 mb-4">
                            <i class="fas fa-check text-green-600 text-2xl" aria-hidden="true"></i>
                        </div>
                        <h3 class="text-lg font-medium text-gray-900 mb-2">Check your email</h3>
                        <p class="text-sm text-gray-600 mb-6">
                            If an account with that email address exists, you will receive a password reset link shortly.
                        </p>
                        <div class="space-y-3">
                            <button @onclick="ResetForm"
                                    class="btn-secondary w-full">
                                <i class="fas fa-arrow-left mr-2" aria-hidden="true"></i>
                                Send another link
                            </button>
                            <a href="Account/Login" 
                               class="block text-center text-sm text-blue-600 hover:text-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 rounded-md px-1">
                                Back to sign in
                            </a>
                        </div>
                    </div>
                }

                <!-- Help text -->
                @if (!_emailSent)
                {
                    <div class="mt-6 text-center">
                        <div class="text-xs text-gray-500">
                            <p class="mb-1">
                                <i class="fas fa-info-circle mr-1" aria-hidden="true"></i>
                                Password reset links expire after 24 hours for security.
                            </p>
                            <p>
                                Still having trouble? Contact support for assistance.
                            </p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private bool _isLoading;
    private bool _emailSent;
    private string? _statusMessage;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    private async Task OnValidSubmitAsync()
    {
        _isLoading = true;
        _statusMessage = null;
        StateHasChanged();

        try
        {
            var request = new PasswordResetRequest
            {
                Email = Input.Email
            };

            var json = JsonSerializer.Serialize(request);
            var content = new StringContent(json, System.Text.Encoding.UTF8, "application/json");

            var response = await HttpClient.PostAsync("api/passwordreset/request", content);

            if (response.IsSuccessStatusCode)
            {
                _emailSent = true;
                Logger.LogInformation("Password reset request submitted for email: {Email}", Input.Email);
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.TooManyRequests)
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                var errorResponse = JsonSerializer.Deserialize<JsonElement>(errorContent);
                
                if (errorResponse.TryGetProperty("retryAfter", out var retryAfter))
                {
                    var minutes = Math.Ceiling(retryAfter.GetDouble());
                    _statusMessage = $"Error: Too many attempts. Please try again in {minutes} minutes.";
                }
                else
                {
                    _statusMessage = "Error: Too many password reset attempts. Please try again later.";
                }
                
                Logger.LogWarning("Password reset rate limit exceeded for email: {Email}", Input.Email);
            }
            else
            {
                _statusMessage = "Error: Unable to process your request. Please try again.";
                Logger.LogError("Password reset request failed with status: {StatusCode} for email: {Email}", 
                    response.StatusCode, Input.Email);
            }
        }
        catch (Exception ex)
        {
            _statusMessage = "Error: An unexpected error occurred. Please try again.";
            Logger.LogError(ex, "Exception occurred during password reset request for email: {Email}", Input.Email);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private void ResetForm()
    {
        _emailSent = false;
        _statusMessage = null;
        Input.Email = string.Empty;
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Email address is required")]
        [EmailAddress(ErrorMessage = "Please enter a valid email address")]
        [StringLength(256, ErrorMessage = "Email address cannot exceed 256 characters")]
        public string Email { get; set; } = string.Empty;
    }
}
@page "/search"
@using AIPromptManager.Models
@using AIPromptManager.Services
@using AIPromptManager.Components.Shared
@inject IPromptService PromptService
@inject IToastService ToastService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Search Prompts - AI Prompt Manager</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-2xl font-bold text-gray-900">Search Prompts</h1>
        <p class="mt-1 text-sm text-gray-600">Find prompts by title, description, content, or tags</p>
    </div>

    <!-- Search Bar -->
    <div class="flex justify-center">
        <div class="w-full max-w-2xl">
            <SearchBar @bind-SearchTerm="_searchTerm" 
                      OnSearch="HandleSearch" 
                      OnClear="HandleClearSearch"
                      IsSearching="_isSearching"
                      SearchResultCount="_searchResults.Count"
                      Placeholder="Search prompts by title, description, content, or tags..." />
        </div>
    </div>

    <!-- Active Filter Display -->
    @if (!string.IsNullOrEmpty(_activeTagFilter))
    {
        <div class="flex justify-center">
            <div class="flex items-center space-x-2">
                <span class="text-sm text-gray-600">Filtered by tag:</span>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                    @_activeTagFilter
                    <button @onclick="ClearTagFilter" class="ml-1 text-blue-600 hover:text-blue-800">
                        <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                        </svg>
                    </button>
                </span>
            </div>
        </div>
    }

    <!-- Search Results -->
    @if (_hasSearched)
    {
        <PromptList Prompts="_searchResults" 
                   IsLoading="_isSearching"
                   SearchTerm="searchTerm"
                   OnEdit="HandleEdit" 
                   OnDelete="HandleDelete" 
                   OnTagClick="HandleTagClick"
                   OnCreateNew="HandleCreateNew" />
    }
    else
    {
        <!-- Initial State -->
        <div class="bg-white shadow rounded-lg p-6">
            <div class="text-center py-12">
                <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
                <h3 class="mt-2 text-sm font-medium text-gray-900">Start searching</h3>
                <p class="mt-1 text-sm text-gray-500">Enter a search term above to find your prompts by title, description, content, or tags.</p>
            </div>
        </div>
    }

    <!-- Delete Confirmation Dialog -->
    <ConfirmDialog IsVisible="_showDeleteConfirmation"
                   Title="Delete Prompt"
                   Message="@GetDeleteConfirmationMessage()"
                   ConfirmText="Delete"
                   CancelText="Cancel"
                   ProcessingText="Deleting..."
                   Type="ConfirmDialog.ConfirmDialogType.Danger"
                   IsProcessing="_isDeletingPrompt"
                   CloseOnBackdropClick="true"
                   OnConfirm="ConfirmDelete"
                   OnCancel="CancelDelete" />
</div>

@code {
    private List<Prompt> _searchResults = new();
    private bool _isSearching;
    private bool _hasSearched;
    private string _searchTerm = string.Empty;
    private string _activeTagFilter = string.Empty;
    
    // Delete confirmation state
    private bool _showDeleteConfirmation;
    private Prompt? _promptToDelete;
    private bool _isDeletingPrompt;

    private async Task HandleSearch(string term)
    {
        try
        {
            _isSearching = true;
            _searchTerm = term;
            _hasSearched = true;
            StateHasChanged();
            
            await PerformSearchAsync();
        }
        finally
        {
            _isSearching = false;
            StateHasChanged();
        }
    }

    private void HandleClearSearch()
    {
        try
        {
            _isSearching = true;
            _searchTerm = string.Empty;
            _activeTagFilter = string.Empty;
            _hasSearched = false;
            StateHasChanged();
            
            _searchResults.Clear();
        }
        finally
        {
            _isSearching = false;
            StateHasChanged();
        }
    }

    private async Task PerformSearchAsync()
    {
        try
        {
            IEnumerable<Prompt> results;

            if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                results = await PromptService.SearchPromptsAsync(_searchTerm);
            }
            else
            {
                results = await PromptService.GetAllPromptsAsync();
            }

            // Apply tag filter
            if (!string.IsNullOrWhiteSpace(_activeTagFilter))
            {
                results = results.Where(p => p.Tags.Any(t => t.Name.Equals(_activeTagFilter, StringComparison.OrdinalIgnoreCase)));
            }

            _searchResults = results.ToList();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error searching prompts: {ex.Message}", "Search Error");
            _searchResults = new List<Prompt>();
        }
    }

    private void HandleEdit(Prompt prompt)
    {
        Navigation.NavigateTo($"/edit/{prompt.Id}");
    }

    private void HandleDelete(Prompt prompt)
    {
        _promptToDelete = prompt;
        _showDeleteConfirmation = true;
        StateHasChanged();
    }

    private async Task HandleTagClick(string tagName)
    {
        _activeTagFilter = tagName;
        await PerformSearchAsync();
    }

    private void HandleCreateNew()
    {
        Navigation.NavigateTo("/create");
    }

    private async Task ClearTagFilter()
    {
        _activeTagFilter = string.Empty;
        await PerformSearchAsync();
    }

    private string GetDeleteConfirmationMessage()
    {
        if (_promptToDelete == null) return "Are you sure you want to delete this prompt?";
        return $"Are you sure you want to delete \"{_promptToDelete.Title}\"? This action cannot be undone.";
    }

    private void CancelDelete()
    {
        _showDeleteConfirmation = false;
        _promptToDelete = null;
        StateHasChanged();
    }

    private async Task ConfirmDelete()
    {
        if (_promptToDelete == null) return;

        try
        {
            _isDeletingPrompt = true;
            StateHasChanged();

            await PromptService.DeletePromptAsync(_promptToDelete.Id);
            
            // Remove from search results to reflect changes immediately
            _searchResults.RemoveAll(p => p.Id == _promptToDelete.Id);
            
            ToastService.ShowSuccess($"Prompt '{_promptToDelete.Title}' deleted successfully!");
        }
        catch (InvalidOperationException ex) when (ex.Message.Contains("not found"))
        {
            ToastService.ShowWarning("This prompt has already been deleted.", "Warning");
            _searchResults.RemoveAll(p => p.Id == _promptToDelete.Id);
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error deleting prompt: {ex.Message}", "Delete Failed");
        }
        finally
        {
            _isDeletingPrompt = false;
            _showDeleteConfirmation = false;
            _promptToDelete = null;
            StateHasChanged();
        }
    }
}
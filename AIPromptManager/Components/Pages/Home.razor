@page "/"
@using AIPromptManager.Components.Shared

<PageTitle>AI Prompt Manager</PageTitle>

<div class="space-y-8">
    <!-- Storage Status -->
    <StorageStatus ShowDetails="false" 
                   AutoRefresh="true" 
                   RefreshIntervalSeconds="60"
                   OnError="HandleStorageError"
                   OnSuccess="HandleStorageSuccess" />
    <!-- Hero Section -->
    <header class="text-center" role="banner">
        <h1 class="text-4xl font-bold text-gray-900 sm:text-5xl">
            AI Prompt Manager
        </h1>
        <p class="mt-4 text-xl text-gray-600 max-w-3xl mx-auto">
            Organize, manage, and access your AI prompts in one centralized location. 
            Create, categorize, and search through your prompt collection with ease.
        </p>
    </header>

    <!-- Quick Actions -->
    <section aria-labelledby="quick-actions-heading">
        <h2 id="quick-actions-heading" class="sr-only">Quick Actions</h2>
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" role="list">
            <article class="bg-white overflow-hidden shadow rounded-lg" role="listitem">
                <div class="p-6">
                    <div class="flex items-center">
                        <div class="flex-shrink-0" aria-hidden="true">
                            <i class="fas fa-plus-circle fa-3x text-blue-600" aria-hidden="true"></i>
                        </div>
                        <div class="ml-4">
                            <h3 class="text-lg font-medium text-gray-900">Create Prompt</h3>
                            <p class="text-sm text-gray-500">Add a new AI prompt to your collection</p>
                        </div>
                    </div>
                    <div class="mt-4">
                        <a href="/create" 
                           class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-blue-700 bg-blue-100 hover:bg-blue-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500"
                           aria-label="Create a new prompt">
                            Get Started
                        </a>
                    </div>
                </div>
            </article>

            <article class="bg-white overflow-hidden shadow rounded-lg" role="listitem">
                <div class="p-6">
                    <div class="flex items-center">
                        <div class="flex-shrink-0" aria-hidden="true">
                            <i class="fas fa-list-alt fa-3x text-green-600" aria-hidden="true"></i>
                        </div>
                        <div class="ml-4">
                            <h3 class="text-lg font-medium text-gray-900">Browse Prompts</h3>
                            <p class="text-sm text-gray-500">View and manage your existing prompts</p>
                        </div>
                    </div>
                    <div class="mt-4">
                        <a href="/prompts" 
                           class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-green-700 bg-green-100 hover:bg-green-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500"
                           aria-label="Browse existing prompts">
                            View All
                        </a>
                    </div>
                </div>
            </article>

            <article class="bg-white overflow-hidden shadow rounded-lg" role="listitem">
                <div class="p-6">
                    <div class="flex items-center">
                        <div class="flex-shrink-0" aria-hidden="true">
                            <i class="fas fa-search fa-3x text-purple-600" aria-hidden="true"></i>
                        </div>
                        <div class="ml-4">
                            <h3 class="text-lg font-medium text-gray-900">Search Prompts</h3>
                            <p class="text-sm text-gray-500">Find specific prompts quickly</p>
                        </div>
                    </div>
                    <div class="mt-4">
                        <a href="/search" 
                           class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-purple-700 bg-purple-100 hover:bg-purple-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-purple-500"
                           aria-label="Search through prompts">
                            Search
                        </a>
                    </div>
                </div>
            </article>
        </div>
    </section>

    <!-- Features Section -->
    <section class="bg-white shadow rounded-lg p-6" aria-labelledby="features-heading">
        <h2 id="features-heading" class="text-2xl font-bold text-gray-900 mb-6">Key Features</h2>
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2" role="list">
            <article class="flex items-start" role="listitem">
                <div class="flex-shrink-0" aria-hidden="true">
                    <div class="flex items-center justify-center h-10 w-10 rounded-md bg-blue-500 text-white">
                        <i class="fas fa-tags fa-lg" aria-hidden="true"></i>
                    </div>
                </div>
                <div class="ml-4">
                    <h3 class="text-lg font-medium text-gray-900">Organize with Tags</h3>
                    <p class="text-sm text-gray-500">Categorize your prompts with custom tags for easy organization and filtering.</p>
                </div>
            </article>

            <article class="flex items-start" role="listitem">
                <div class="flex-shrink-0" aria-hidden="true">
                    <div class="flex items-center justify-center h-10 w-10 rounded-md bg-green-500 text-white">
                        <i class="fas fa-copy fa-lg" aria-hidden="true"></i>
                    </div>
                </div>
                <div class="ml-4">
                    <h3 class="text-lg font-medium text-gray-900">Quick Copy</h3>
                    <p class="text-sm text-gray-500">Copy prompts to your clipboard with a single click for immediate use.</p>
                </div>
            </article>

            <article class="flex items-start" role="listitem">
                <div class="flex-shrink-0" aria-hidden="true">
                    <div class="flex items-center justify-center h-10 w-10 rounded-md bg-purple-500 text-white">
                        <i class="fas fa-search fa-lg" aria-hidden="true"></i>
                    </div>
                </div>
                <div class="ml-4">
                    <h3 class="text-lg font-medium text-gray-900">Powerful Search</h3>
                    <p class="text-sm text-gray-500">Search through titles, descriptions, content, and tags to find exactly what you need.</p>
                </div>
            </article>

            <article class="flex items-start" role="listitem">
                <div class="flex-shrink-0" aria-hidden="true">
                    <div class="flex items-center justify-center h-10 w-10 rounded-md bg-orange-500 text-white">
                        <i class="fas fa-mobile-alt fa-lg" aria-hidden="true"></i>
                    </div>
                </div>
                <div class="ml-4">
                    <h3 class="text-lg font-medium text-gray-900">Responsive Design</h3>
                    <p class="text-sm text-gray-500">Access your prompts from any device with a fully responsive interface.</p>
                </div>
            </article>
        </div>
    </section>
</div>

@code {
    private void HandleStorageError(string error)
    {
        // Handle storage errors - could show toast notification
        // For now, just log the error
        Console.WriteLine($"Storage error: {error}");
    }

    private void HandleStorageSuccess(string message)
    {
        // Handle storage success messages
        Console.WriteLine($"Storage success: {message}");
    }
}

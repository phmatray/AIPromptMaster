@page "/admin"
@using AIPromptManager.Models
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize(Roles = "Admin")]
@inject IAdminService AdminService
@inject ILogger<AdminDashboard> Logger
@inject NavigationManager Navigation

<PageTitle>Admin Dashboard - AI Prompt Manager</PageTitle>

<div class="space-y-8">
    <!-- Header -->
    <div class="md:flex md:items-center md:justify-between">
        <div class="flex-1 min-w-0">
            <h1 class="text-2xl font-bold leading-7 text-gray-900 sm:text-3xl sm:truncate">
                <i class="fas fa-tachometer-alt mr-2 text-blue-600"></i>
                Admin Dashboard
            </h1>
            <p class="mt-1 text-sm text-gray-500">
                System overview and administrative controls
            </p>
        </div>
        <div class="mt-4 flex md:mt-0 md:ml-4">
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800">
                <i class="fas fa-circle mr-1 text-xs"></i>
                System Online
            </span>
        </div>
    </div>

    <!-- Status Message -->
    <StatusMessage Message="@statusMessage" />

    <!-- Quick Navigation -->
    <div class="bg-white shadow rounded-lg">
        <div class="p-6">
            <h2 class="text-lg font-medium text-gray-900 mb-4">
                <i class="fas fa-compass mr-2 text-purple-600"></i>
                Quick Actions
            </h2>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
                <a href="/admin/users" 
                   class="relative rounded-lg border border-gray-300 bg-white px-6 py-4 shadow-sm flex items-center space-x-3 hover:border-gray-400 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                    <div class="flex-shrink-0">
                        <i class="fas fa-users-cog fa-lg text-blue-600"></i>
                    </div>
                    <div class="flex-1 min-w-0">
                        <span class="absolute inset-0" aria-hidden="true"></span>
                        <p class="text-sm font-medium text-gray-900">User Management</p>
                        <p class="text-sm text-gray-500 truncate">Manage users and roles</p>
                    </div>
                </a>

                <a href="/admin/prompts" 
                   class="relative rounded-lg border border-gray-300 bg-white px-6 py-4 shadow-sm flex items-center space-x-3 hover:border-gray-400 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                    <div class="flex-shrink-0">
                        <i class="fas fa-file-alt fa-lg text-green-600"></i>
                    </div>
                    <div class="flex-1 min-w-0">
                        <span class="absolute inset-0" aria-hidden="true"></span>
                        <p class="text-sm font-medium text-gray-900">Prompt Management</p>
                        <p class="text-sm text-gray-500 truncate">View and manage all prompts</p>
                    </div>
                </a>

                <a href="/performance" 
                   class="relative rounded-lg border border-gray-300 bg-white px-6 py-4 shadow-sm flex items-center space-x-3 hover:border-gray-400 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                    <div class="flex-shrink-0">
                        <i class="fas fa-chart-bar fa-lg text-purple-600"></i>
                    </div>
                    <div class="flex-1 min-w-0">
                        <span class="absolute inset-0" aria-hidden="true"></span>
                        <p class="text-sm font-medium text-gray-900">Performance Monitor</p>
                        <p class="text-sm text-gray-500 truncate">View system performance</p>
                    </div>
                </a>
            </div>
        </div>
    </div>

    <!-- System Statistics -->
    @if (systemStats != null)
    {
        <div>
            <h2 class="text-lg font-medium text-gray-900 mb-4">
                <i class="fas fa-chart-pie mr-2 text-orange-600"></i>
                System Statistics
            </h2>
            <AdminSystemStats Stats="systemStats" />
        </div>
    }
    else if (isLoading)
    {
        <div class="bg-white shadow rounded-lg p-6">
            <div class="text-center">
                <i class="fas fa-spinner fa-spin fa-2x text-gray-400 mb-4"></i>
                <p class="text-gray-500">Loading dashboard data...</p>
            </div>
        </div>
    }
    else
    {
        <div class="bg-red-50 border border-red-200 rounded-lg p-6">
            <div class="flex">
                <div class="flex-shrink-0">
                    <i class="fas fa-exclamation-circle text-red-400"></i>
                </div>
                <div class="ml-3">
                    <h3 class="text-sm font-medium text-red-800">Error Loading Dashboard</h3>
                    <div class="mt-2 text-sm text-red-700">
                        <p>Unable to load system statistics. Please try refreshing the page.</p>
                    </div>
                    <div class="mt-4">
                        <button @onclick="LoadDashboardData" 
                                class="bg-red-100 px-3 py-2 rounded-md text-sm font-medium text-red-800 hover:bg-red-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500">
                            Retry
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Recent Activity Summary -->
    @if (systemStats != null)
    {
        <div class="bg-white shadow rounded-lg">
            <div class="p-6">
                <h2 class="text-lg font-medium text-gray-900 mb-4">
                    <i class="fas fa-clock mr-2 text-indigo-600"></i>
                    Recent Activity Summary
                </h2>
                <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
                    <div>
                        <h3 class="text-sm font-medium text-gray-500 mb-3">User Activity (Last 30 Days)</h3>
                        <div class="space-y-3">
                            <div class="flex items-center justify-between">
                                <span class="text-sm text-gray-900">Active Users</span>
                                <span class="text-sm font-medium text-gray-900">@systemStats.ActiveUsersLast30Days of @systemStats.TotalUsers</span>
                            </div>
                            <div class="w-full bg-gray-200 rounded-full h-2">
                                <div class="bg-blue-600 h-2 rounded-full" style="width: @(systemStats.UserActivityRate)%"></div>
                            </div>
                            <p class="text-xs text-gray-500">@systemStats.UserActivityRate% activity rate</p>
                        </div>
                    </div>
                    <div>
                        <h3 class="text-sm font-medium text-gray-500 mb-3">Content Growth</h3>
                        <div class="space-y-3">
                            <div class="flex items-center justify-between">
                                <span class="text-sm text-gray-900">New Prompts</span>
                                <span class="text-sm font-medium text-gray-900">@systemStats.PromptsCreatedLast30Days</span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-sm text-gray-900">Avg per User</span>
                                <span class="text-sm font-medium text-gray-900">@systemStats.AveragePromptsPerUser</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private SystemStatsModel? systemStats;
    private bool isLoading = true;
    private string? statusMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardData();
    }

    private async Task LoadDashboardData()
    {
        try
        {
            isLoading = true;
            statusMessage = null;
            StateHasChanged();

            systemStats = await AdminService.GetSystemStatsAsync();
            
            Logger.LogInformation("Admin dashboard loaded successfully");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading admin dashboard data");
            statusMessage = "Error: Failed to load dashboard data. Please try again.";
            systemStats = null;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}
@page "/admin/prompts"
@using AIPromptManager.Models
@using Microsoft.AspNetCore.Components.Authorization
@using AIPromptManager.Components.Shared
@attribute [Authorize(Roles = "Admin")]
@inject IAdminService AdminService
@inject IPromptService PromptService
@inject ILogger<AdminPromptManagement> Logger
@inject NavigationManager Navigation

<PageTitle>Prompt Management - Admin - AI Prompt Manager</PageTitle>

<div class="space-y-8">
    <!-- Header -->
    <div class="md:flex md:items-center md:justify-between">
        <div class="flex-1 min-w-0">
            <nav class="flex" aria-label="Breadcrumb">
                <ol class="flex items-center space-x-4">
                    <li>
                        <div>
                            <a href="/admin" class="text-gray-400 hover:text-gray-500">
                                <i class="fas fa-tachometer-alt" aria-hidden="true"></i>
                                <span class="sr-only">Admin Dashboard</span>
                            </a>
                        </div>
                    </li>
                    <li>
                        <div class="flex items-center">
                            <i class="fas fa-chevron-right text-gray-400" aria-hidden="true"></i>
                            <span class="ml-4 text-sm font-medium text-gray-500">Prompt Management</span>
                        </div>
                    </li>
                </ol>
            </nav>
            <h1 class="mt-2 text-2xl font-bold leading-7 text-gray-900 sm:text-3xl sm:truncate">
                <i class="fas fa-file-alt mr-2 text-green-600"></i>
                Prompt Management
            </h1>
            <p class="mt-1 text-sm text-gray-500">
                View and manage prompts from all users
            </p>
        </div>
        <div class="mt-4 flex md:mt-0 md:ml-4">
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                @if (filteredPrompts != null)
                {
                    <span>@filteredPrompts.Count() prompts</span>
                }
                else
                {
                    <span>Loading...</span>
                }
            </span>
        </div>
    </div>

    <!-- Status Message -->
    <StatusMessage Message="@statusMessage" />

    <!-- Search and Filters -->
    <div class="bg-white shadow rounded-lg">
        <div class="p-6">
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
                <div>
                    <label for="search" class="block text-sm font-medium text-gray-700">Search Prompts</label>
                    <div class="mt-1 relative">
                        <input @bind="searchTerm" @oninput="OnSearchChanged"
                               type="text" id="search" 
                               class="shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md"
                               placeholder="Title, description, or content..." />
                        <div class="absolute inset-y-0 right-0 pr-3 flex items-center">
                            <i class="fas fa-search text-gray-400" aria-hidden="true"></i>
                        </div>
                    </div>
                </div>
                <div>
                    <label for="user-filter" class="block text-sm font-medium text-gray-700">Filter by User</label>
                    <select @bind="selectedUserFilter" @onchange="OnUserFilterChanged"
                            id="user-filter" 
                            class="mt-1 block w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm rounded-md">
                        <option value="">All Users</option>
                        @if (uniqueUsers != null)
                        {
                            @foreach (var user in uniqueUsers)
                            {
                                <option value="@user.Id">@(user.DisplayName ?? user.UserName ?? user.Email)</option>
                            }
                        }
                    </select>
                </div>
                <div>
                    <label for="sort-by" class="block text-sm font-medium text-gray-700">Sort By</label>
                    <select @bind="sortBy" @onchange="OnSortChanged"
                            id="sort-by" 
                            class="mt-1 block w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm rounded-md">
                        <option value="created-desc">Newest First</option>
                        <option value="created-asc">Oldest First</option>
                        <option value="updated-desc">Recently Updated</option>
                        <option value="title-asc">Title A-Z</option>
                        <option value="title-desc">Title Z-A</option>
                        <option value="user-asc">User A-Z</option>
                    </select>
                </div>
                <div class="flex items-end">
                    <button @onclick="RefreshPrompts" disabled="@isLoading"
                            class="inline-flex items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 disabled:opacity-50 disabled:cursor-not-allowed">
                        <i class="fas fa-sync-alt -ml-1 mr-2 @(isLoading ? "fa-spin" : "")" aria-hidden="true"></i>
                        Refresh
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Prompts List -->
    @if (isLoading)
    {
        <div class="bg-white shadow rounded-lg p-6">
            <div class="text-center">
                <i class="fas fa-spinner fa-spin fa-2x text-gray-400 mb-4"></i>
                <p class="text-gray-500">Loading prompts...</p>
            </div>
        </div>
    }
    else if (filteredPrompts?.Any() == true)
    {
        <!-- Pagination Controls -->
        @if (totalPages > 1)
        {
            <div class="bg-white px-4 py-3 flex items-center justify-between border-t border-gray-200 sm:px-6 rounded-lg shadow">
                <div class="flex-1 flex justify-between sm:hidden">
                    <button @onclick="PreviousPage" disabled="@(currentPage <= 1)"
                            class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed">
                        Previous
                    </button>
                    <button @onclick="NextPage" disabled="@(currentPage >= totalPages)"
                            class="ml-3 relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed">
                        Next
                    </button>
                </div>
                <div class="hidden sm:flex-1 sm:flex sm:items-center sm:justify-between">
                    <div>
                        <p class="text-sm text-gray-700">
                            Showing <span class="font-medium">@((currentPage - 1) * pageSize + 1)</span> to 
                            <span class="font-medium">@Math.Min(currentPage * pageSize, filteredPrompts.Count())</span> of 
                            <span class="font-medium">@filteredPrompts.Count()</span> results
                        </p>
                    </div>
                    <div>
                        <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px" aria-label="Pagination">
                            <button @onclick="PreviousPage" disabled="@(currentPage <= 1)"
                                    class="relative inline-flex items-center px-2 py-2 rounded-l-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed">
                                <span class="sr-only">Previous</span>
                                <i class="fas fa-chevron-left" aria-hidden="true"></i>
                            </button>
                            @for (int page = Math.Max(1, currentPage - 2); page <= Math.Min(totalPages, currentPage + 2); page++)
                            {
                                int pageNumber = page; // Capture for lambda
                                <button @onclick="() => GoToPage(pageNumber)" 
                                        class="@(page == currentPage ? "bg-indigo-50 border-indigo-500 text-indigo-600 z-10" : "bg-white border-gray-300 text-gray-500 hover:bg-gray-50") relative inline-flex items-center px-4 py-2 border text-sm font-medium">
                                    @page
                                </button>
                            }
                            <button @onclick="NextPage" disabled="@(currentPage >= totalPages)"
                                    class="relative inline-flex items-center px-2 py-2 rounded-r-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed">
                                <span class="sr-only">Next</span>
                                <i class="fas fa-chevron-right" aria-hidden="true"></i>
                            </button>
                        </nav>
                    </div>
                </div>
            </div>
        }

        <!-- Prompts Grid -->
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
            @foreach (var prompt in GetCurrentPagePrompts())
            {
                <div class="bg-white shadow rounded-lg overflow-hidden">
                    <div class="p-6">
                        <!-- Header with User Info -->
                        <div class="flex items-center justify-between mb-4">
                            <div class="flex items-center space-x-3">
                                <div class="flex-shrink-0">
                                    <div class="h-8 w-8 rounded-full bg-gray-300 flex items-center justify-center">
                                        <i class="fas fa-user text-gray-500 text-sm"></i>
                                    </div>
                                </div>
                                <div class="min-w-0 flex-1">
                                    <p class="text-sm font-medium text-gray-900 truncate">
                                        @(prompt.User?.DisplayName ?? prompt.User?.UserName ?? "Unknown User")
                                    </p>
                                    <p class="text-xs text-gray-500 truncate">
                                        @prompt.User?.Email
                                    </p>
                                </div>
                            </div>
                            <div class="flex items-center space-x-2">
                                <button @onclick="() => ViewPrompt(prompt)" 
                                        class="text-blue-600 hover:text-blue-900 text-sm font-medium"
                                        title="View Details">
                                    <i class="fas fa-eye mr-1"></i>
                                    View
                                </button>
                                <button @onclick="() => ShowDeleteConfirmation(prompt)" 
                                        class="text-red-600 hover:text-red-900 text-sm font-medium"
                                        title="Delete Prompt">
                                    <i class="fas fa-trash-alt mr-1"></i>
                                    Delete
                                </button>
                            </div>
                        </div>

                        <!-- Prompt Info -->
                        <div class="space-y-3">
                            <div>
                                <h3 class="text-lg font-medium text-gray-900 line-clamp-2">
                                    @prompt.Title
                                </h3>
                                @if (!string.IsNullOrEmpty(prompt.Description))
                                {
                                    <p class="text-sm text-gray-600 mt-1 line-clamp-2">
                                        @prompt.Description
                                    </p>
                                }
                            </div>

                            <!-- Content Preview -->
                            <div class="bg-gray-50 rounded-md p-3">
                                <p class="text-sm text-gray-700 line-clamp-3">
                                    @prompt.Content
                                </p>
                            </div>

                            <!-- Tags -->
                            @if (prompt.Tags?.Any() == true)
                            {
                                <div class="flex flex-wrap gap-1">
                                    @foreach (var tag in prompt.Tags.Take(5))
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                            @tag.Name
                                        </span>
                                    }
                                    @if (prompt.Tags.Count > 5)
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                                            +@(prompt.Tags.Count - 5) more
                                        </span>
                                    }
                                </div>
                            }

                            <!-- Metadata -->
                            <div class="grid grid-cols-2 gap-4 text-sm text-gray-500">
                                <div>
                                    <span class="font-medium">Created:</span>
                                    <span class="block">@prompt.CreatedAt.ToString("MMM dd, yyyy")</span>
                                </div>
                                <div>
                                    <span class="font-medium">Updated:</span>
                                    <span class="block">@prompt.UpdatedAt.ToString("MMM dd, yyyy")</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="bg-white shadow rounded-lg p-6 text-center">
            <i class="fas fa-file-alt fa-3x text-gray-400 mb-4"></i>
            <h3 class="text-lg font-medium text-gray-900 mb-2">No Prompts Found</h3>
            <p class="text-gray-500">
                @if (!string.IsNullOrEmpty(searchTerm) || !string.IsNullOrEmpty(selectedUserFilter))
                {
                    <span>No prompts match your current search criteria.</span>
                }
                else
                {
                    <span>No prompts have been created in the system yet.</span>
                }
            </p>
        </div>
    }
</div>

<!-- Delete Confirmation Dialog -->
<ConfirmDialog IsVisible="@showDeleteDialog"
               Title="Delete Prompt"
               Message="@deleteDialogMessage"
               ConfirmText="Delete"
               CancelText="Cancel"
               Type="ConfirmDialogType.Danger"
               IsProcessing="@isProcessing"
               ProcessingText="Deleting..."
               OnConfirm="ConfirmDeletePrompt"
               OnCancel="CancelDeletePrompt" />

@code {
    private IEnumerable<Prompt>? allPrompts;
    private IEnumerable<Prompt>? filteredPrompts;
    private IEnumerable<ApplicationUser>? uniqueUsers;
    private bool isLoading = true;
    private bool isProcessing = false;
    private string? statusMessage;
    private string searchTerm = "";
    private string selectedUserFilter = "";
    private string sortBy = "created-desc";

    // Pagination
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages = 0;

    // Delete confirmation
    private bool showDeleteDialog = false;
    private Prompt? promptToDelete;
    private string deleteDialogMessage = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            allPrompts = await AdminService.GetAllPromptsAsync();
            
            // Extract unique users from prompts
            uniqueUsers = allPrompts
                .Where(p => p.User != null)
                .Select(p => p.User!)
                .GroupBy(u => u.Id)
                .Select(g => g.First())
                .OrderBy(u => u.DisplayName ?? u.UserName ?? u.Email);

            ApplyFilters();

            Logger.LogInformation("Prompt management data loaded successfully");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading prompt management data");
            statusMessage = "Error: Failed to load prompt data. Please try again.";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ApplyFilters()
    {
        if (allPrompts == null)
        {
            filteredPrompts = null;
            return;
        }

        var query = allPrompts.AsQueryable();

        // Apply search filter
        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var search = searchTerm.ToLower();
            query = query.Where(p => 
                p.Title.ToLower().Contains(search) ||
                (p.Description != null && p.Description.ToLower().Contains(search)) ||
                p.Content.ToLower().Contains(search) ||
                (p.Tags != null && p.Tags.Any(t => t.Name.ToLower().Contains(search))));
        }

        // Apply user filter
        if (!string.IsNullOrWhiteSpace(selectedUserFilter))
        {
            query = query.Where(p => p.UserId == selectedUserFilter);
        }

        // Apply sorting
        query = sortBy switch
        {
            "created-asc" => query.OrderBy(p => p.CreatedAt),
            "created-desc" => query.OrderByDescending(p => p.CreatedAt),
            "updated-desc" => query.OrderByDescending(p => p.UpdatedAt),
            "title-asc" => query.OrderBy(p => p.Title),
            "title-desc" => query.OrderByDescending(p => p.Title),
            "user-asc" => query.OrderBy(p => p.User != null ? p.User.DisplayName ?? p.User.UserName ?? p.User.Email : ""),
            _ => query.OrderByDescending(p => p.CreatedAt)
        };

        filteredPrompts = query.ToList();
        
        // Reset pagination
        currentPage = 1;
        totalPages = (int)Math.Ceiling((double)filteredPrompts.Count() / pageSize);
        
        StateHasChanged();
    }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        ApplyFilters();
    }

    private void OnUserFilterChanged(ChangeEventArgs e)
    {
        selectedUserFilter = e.Value?.ToString() ?? "";
        ApplyFilters();
    }

    private void OnSortChanged(ChangeEventArgs e)
    {
        sortBy = e.Value?.ToString() ?? "created-desc";
        ApplyFilters();
    }

    private async Task RefreshPrompts()
    {
        statusMessage = null;
        await LoadData();
    }

    private IEnumerable<Prompt> GetCurrentPagePrompts()
    {
        if (filteredPrompts == null) return Enumerable.Empty<Prompt>();
        
        return filteredPrompts
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize);
    }

    private void PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            StateHasChanged();
        }
    }

    private void NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            StateHasChanged();
        }
    }

    private void GoToPage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
            StateHasChanged();
        }
    }

    private void ViewPrompt(Prompt prompt)
    {
        Navigation.NavigateTo($"/prompts/{prompt.Id}");
    }

    private void ShowDeleteConfirmation(Prompt prompt)
    {
        promptToDelete = prompt;
        deleteDialogMessage = $"Are you sure you want to delete the prompt '{prompt.Title}' by {prompt.User?.DisplayName ?? prompt.User?.UserName ?? "Unknown User"}? This action cannot be undone.";
        showDeleteDialog = true;
    }

    private async Task ConfirmDeletePrompt()
    {
        if (promptToDelete == null || isProcessing) return;

        try
        {
            isProcessing = true;
            StateHasChanged();

            await PromptService.DeleteAsync(promptToDelete.Id);
            
            statusMessage = $"Success: Prompt '{promptToDelete.Title}' has been deleted.";
            
            // Remove from local collections
            if (allPrompts != null)
            {
                allPrompts = allPrompts.Where(p => p.Id != promptToDelete.Id).ToList();
            }
            ApplyFilters();

            Logger.LogInformation("Prompt {PromptId} deleted by admin", promptToDelete.Id);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting prompt {PromptId}", promptToDelete.Id);
            statusMessage = "Error: An unexpected error occurred while deleting the prompt.";
        }
        finally
        {
            showDeleteDialog = false;
            promptToDelete = null;
            isProcessing = false;
            StateHasChanged();
        }
    }

    private Task CancelDeletePrompt()
    {
        showDeleteDialog = false;
        promptToDelete = null;
        return Task.CompletedTask;
    }
}
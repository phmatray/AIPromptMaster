@page "/create"
@using AIPromptManager.Models
@using AIPromptManager.Services
@using AIPromptManager.Components.Shared
@inject IToastService ToastService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Create Prompt - AI Prompt Manager</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-2xl font-bold text-gray-900">Create New Prompt</h1>
        <p class="mt-1 text-sm text-gray-600">Add a new AI prompt to your collection</p>
    </div>

    <!-- Prompt Form -->
    <div class="bg-white shadow rounded-lg">
        <PromptForm OnSave="@HandleSave" 
                   OnCancel="@HandleCancel"
                   OnError="@HandleError" />
    </div>
</div>

@code {
    private void HandleSave(Prompt savedPrompt)
    {
        // Show success message
        ToastService.ShowSuccess($"Prompt '{savedPrompt.Title}' created successfully!");
        
        // Navigate back to prompts list
        Navigation.NavigateTo("/prompts");
    }

    private void HandleCancel()
    {
        // Navigate back to prompts list
        Navigation.NavigateTo("/prompts");
    }

    private void HandleError(string errorMessage)
    {
        // Show error message
        ToastService.ShowError(errorMessage, "Error");
    }
}
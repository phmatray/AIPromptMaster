@page "/create"
@using AIPromptManager.Models
@using AIPromptManager.Services
@using AIPromptManager.Components.Shared
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IToastService ToastService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Create Prompt - AI Prompt Manager</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="space-y-6">
            <div>
                <h1 class="text-2xl font-bold text-gray-900">Create New Prompt</h1>
                <p class="mt-1 text-sm text-gray-600">Add a new AI prompt to your collection</p>
            </div>

            <!-- Prompt Form -->
            <div class="bg-white shadow rounded-lg">
                <PromptForm OnSave="@HandleSave" 
                           OnCancel="@HandleCancel"
                           OnError="@HandleError" />
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="text-center py-12">
            <div class="flex justify-center mb-6">
                <i class="fas fa-lock fa-4x text-red-400" aria-hidden="true"></i>
            </div>
            <h1 class="text-3xl font-bold text-gray-900 mb-4">Authentication Required</h1>
            <p class="text-lg text-gray-600 mb-8 max-w-2xl mx-auto">
                You need to be logged in to create new prompts. Please sign in to your account to access this feature.
            </p>
            <div class="space-y-3 sm:space-y-0 sm:space-x-4 sm:flex sm:justify-center">
                <a href="/Account/Login" 
                   class="inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                    <i class="fas fa-sign-in-alt mr-2"></i>
                    Log In
                </a>
                <a href="/Account/Register" 
                   class="inline-flex items-center px-6 py-3 border border-gray-300 text-base font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                    <i class="fas fa-user-plus mr-2"></i>
                    Create Account
                </a>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private void HandleSave(Prompt savedPrompt)
    {
        // Show success message
        ToastService.ShowSuccess($"Prompt '{savedPrompt.Title}' created successfully!");
        
        // Navigate back to prompts list
        Navigation.NavigateTo("/prompts");
    }

    private void HandleCancel()
    {
        // Navigate back to prompts list
        Navigation.NavigateTo("/prompts");
    }

    private void HandleError(string errorMessage)
    {
        // Show error message
        ToastService.ShowError(errorMessage, "Error");
    }
}
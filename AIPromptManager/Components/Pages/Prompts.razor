@page "/prompts"
@using AIPromptManager.Models
@using AIPromptManager.Services
@using AIPromptManager.Components.Shared
@inject IPromptService PromptService
@inject IToastService ToastService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>My Prompts - AI Prompt Manager</PageTitle>

<div class="space-y-6">
    <header class="flex flex-col sm:flex-row sm:justify-between sm:items-center space-y-4 sm:space-y-0">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">My Prompts</h1>
            <p class="mt-1 text-sm text-gray-600">Manage and organize your AI prompts</p>
        </div>
        <div class="flex flex-col sm:flex-row space-y-2 sm:space-y-0 sm:space-x-3" role="toolbar" aria-label="Prompt management actions">
            <!-- Search Bar -->
            <div class="relative">
                <SearchBar @bind-SearchTerm="_searchTerm" 
                          OnSearch="HandleSearch" 
                          OnClear="HandleClearSearch"
                          IsSearching="_isSearching"
                          SearchResultCount="_filteredPrompts.Count"
                          Placeholder="Search prompts..." />
            </div>
            
            <!-- Create Button -->
            <a href="/create" 
               class="inline-flex items-center justify-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500"
               aria-label="Create a new prompt">
                <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                    <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd"></path>
                </svg>
                Create New Prompt
            </a>
        </div>
    </header>

    <!-- Active Filter Display -->
    @if (!string.IsNullOrEmpty(_activeTagFilter))
    {
        <aside class="flex items-center space-x-2 p-3 bg-blue-50 border border-blue-200 rounded-lg" 
               role="status" 
               aria-live="polite"
               aria-label="Active filter">
            <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.414A1 1 0 013 6.707V4z"></path>
            </svg>
            <span class="text-sm text-blue-700 font-medium">Filtered by tag:</span>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-200 text-blue-800">
                @_activeTagFilter
                <button @onclick="ClearTagFilter" 
                        class="ml-1 text-blue-600 hover:text-blue-800 hover:bg-blue-300 rounded-full p-0.5 transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
                        title="Clear tag filter"
                        aria-label="Clear tag filter for @_activeTagFilter">
                    <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                        <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                    </svg>
                </button>
            </span>
            <span class="text-xs text-blue-600">
                (@_filteredPrompts.Count @(_filteredPrompts.Count == 1 ? "prompt" : "prompts"))
            </span>
        </aside>
    }

    <!-- Prompt List -->
    <main role="main" aria-label="Prompts list">
        <PromptList Prompts="_filteredPrompts" 
                   IsLoading="_isLoading"
                   SearchTerm="searchTerm"
                   OnEdit="HandleEdit" 
                   OnDelete="HandleDelete" 
                   OnTagClick="HandleTagClick"
                   OnCreateNew="HandleCreateNew" />
    </main>

    <!-- Delete Confirmation Dialog -->
    <ConfirmDialog IsVisible="_showDeleteConfirmation"
                   Title="Delete Prompt"
                   Message="@GetDeleteConfirmationMessage()"
                   ConfirmText="Delete"
                   CancelText="Cancel"
                   ProcessingText="Deleting..."
                   Type="ConfirmDialog.ConfirmDialogType.Danger"
                   IsProcessing="_isDeletingPrompt"
                   CloseOnBackdropClick="true"
                   OnConfirm="ConfirmDelete"
                   OnCancel="CancelDelete" />
</div>

@code {
    private List<Prompt> _allPrompts = new();
    private List<Prompt> _filteredPrompts = new();
    private bool _isLoading = true;
    private bool _isSearching;
    private string _searchTerm = string.Empty;
    private string _activeTagFilter = string.Empty;
    
    // Delete confirmation state
    private bool _showDeleteConfirmation;
    private Prompt? _promptToDelete;
    private bool _isDeletingPrompt;

    protected override async Task OnInitializedAsync()
    {
        await LoadPrompts();
    }

    private async Task LoadPrompts()
    {
        try
        {
            _isLoading = true;
            var prompts = await PromptService.GetAllPromptsAsync();
            _allPrompts = prompts.ToList();
            await ApplyFiltersAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading prompts: {ex.Message}", "Error");
            _allPrompts = new List<Prompt>();
            _filteredPrompts = new List<Prompt>();
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ApplyFiltersAsync()
    {
        try
        {
            // Don't show loading spinner for search operations, only for initial load
            if (string.IsNullOrWhiteSpace(_searchTerm) && string.IsNullOrWhiteSpace(_activeTagFilter))
            {
                _isLoading = true;
                StateHasChanged();
            }

            IEnumerable<Prompt> results;

            // Use service search if we have a search term, otherwise get all prompts
            if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                results = await PromptService.SearchPromptsAsync(_searchTerm);
            }
            else
            {
                results = _allPrompts;
            }

            // Apply tag filter
            if (!string.IsNullOrWhiteSpace(_activeTagFilter))
            {
                results = results.Where(p => p.Tags.Any(t => t.Name.Equals(_activeTagFilter, StringComparison.OrdinalIgnoreCase)));
            }

            _filteredPrompts = results.ToList();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error filtering prompts: {ex.Message}", "Error");
            _filteredPrompts = new List<Prompt>();
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleSearch(string term)
    {
        try
        {
            _isSearching = true;
            _searchTerm = term;
            StateHasChanged();
            
            await ApplyFiltersAsync();
        }
        finally
        {
            _isSearching = false;
            StateHasChanged();
        }
    }

    private async Task HandleClearSearch()
    {
        try
        {
            _isSearching = true;
            _searchTerm = string.Empty;
            StateHasChanged();
            
            await ApplyFiltersAsync();
        }
        finally
        {
            _isSearching = false;
            StateHasChanged();
        }
    }

    private void HandleEdit(Prompt prompt)
    {
        // Navigate to edit page
        Navigation.NavigateTo($"/edit/{prompt.Id}");
    }

    private void HandleDelete(Prompt prompt)
    {
        // Show confirmation dialog
        _promptToDelete = prompt;
        _showDeleteConfirmation = true;
        StateHasChanged();
    }

    private async Task HandleTagClick(string tagName)
    {
        // Filter by tag
        _activeTagFilter = tagName;
        await ApplyFiltersAsync();
    }

    private void HandleCreateNew()
    {
        Navigation.NavigateTo("/create");
    }

    private async Task ClearTagFilter()
    {
        _activeTagFilter = string.Empty;
        await ApplyFiltersAsync();
    }

    private string GetDeleteConfirmationMessage()
    {
        if (_promptToDelete == null) return "Are you sure you want to delete this prompt?";
        return $"Are you sure you want to delete \"{_promptToDelete.Title}\"? This action cannot be undone.";
    }

    private void CancelDelete()
    {
        _showDeleteConfirmation = false;
        _promptToDelete = null;
        StateHasChanged();
    }

    private async Task ConfirmDelete()
    {
        if (_promptToDelete == null) return;

        try
        {
            _isDeletingPrompt = true;
            StateHasChanged();

            await PromptService.DeletePromptAsync(_promptToDelete.Id);
            
            // Remove from local lists to reflect changes immediately
            _allPrompts.RemoveAll(p => p.Id == _promptToDelete.Id);
            await ApplyFiltersAsync();
            
            ToastService.ShowSuccess($"Prompt '{_promptToDelete.Title}' deleted successfully!");
        }
        catch (InvalidOperationException ex) when (ex.Message.Contains("not found"))
        {
            // Handle case where prompt was already deleted by another user/session
            ToastService.ShowWarning("This prompt has already been deleted.", "Warning");
            _allPrompts.RemoveAll(p => p.Id == _promptToDelete.Id);
            await ApplyFiltersAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error deleting prompt: {ex.Message}", "Delete Failed");
        }
        finally
        {
            _isDeletingPrompt = false;
            _showDeleteConfirmation = false;
            _promptToDelete = null;
            StateHasChanged();
        }
    }
}
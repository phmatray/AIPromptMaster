@* LoadingSpinner Component *@

<div class="@GetContainerClasses()" role="status" aria-live="polite" aria-label="@AriaLabel">
    @if (ShowInline)
    {
        <div class="flex items-center">
            <div class="@GetSpinnerClasses()"></div>
            @if (!string.IsNullOrEmpty(Message))
            {
                <span class="@GetMessageClasses()">@Message</span>
            }
        </div>
    }
    else
    {
        <div class="@GetSpinnerClasses()"></div>
        @if (!string.IsNullOrEmpty(Message))
        {
            <p class="@GetMessageClasses()">@Message</p>
        }
    }
    <span class="sr-only">@AriaLabel</span>
</div>

@code {
    [Parameter] public string Message { get; set; } = "Loading...";
    [Parameter] public string Size { get; set; } = "medium"; // small, medium, large
    [Parameter] public string Color { get; set; } = "blue"; // blue, gray, white
    [Parameter] public bool ShowInline { get; set; }
    [Parameter] public bool CenterVertically { get; set; }
    [Parameter] public string? CustomAriaLabel { get; set; }
    [Parameter] public string? CustomClasses { get; set; }

    private string GetContainerClasses()
    {
        var classes = new List<string>();

        if (ShowInline)
        {
            classes.Add("inline-flex items-center");
        }
        else
        {
            classes.Add("flex flex-col items-center justify-center");
            
            if (CenterVertically)
            {
                classes.Add("min-h-[200px]");
            }
            else
            {
                classes.Add("py-8");
            }
        }

        if (!string.IsNullOrEmpty(CustomClasses))
        {
            classes.Add(CustomClasses);
        }

        return string.Join(" ", classes);
    }

    private string GetSpinnerClasses()
    {
        var classes = new List<string>
        {
            "animate-spin rounded-full border-solid border-t-transparent"
        };

        // Size classes
        classes.Add(Size switch
        {
            "small" => "h-4 w-4 border-2",
            "large" => "h-12 w-12 border-4",
            _ => "h-8 w-8 border-2" // medium
        });

        // Color classes
        classes.Add(Color switch
        {
            "gray" => "border-gray-300 border-t-gray-600",
            "white" => "border-white/30 border-t-white",
            _ => "border-blue-200 border-t-blue-600" // blue
        });

        return string.Join(" ", classes);
    }

    private string GetMessageClasses()
    {
        var classes = new List<string>();

        if (ShowInline)
        {
            classes.Add("ml-3");
        }
        else
        {
            classes.Add("mt-3");
        }

        // Text size based on spinner size
        classes.Add(Size switch
        {
            "small" => "text-sm",
            "large" => "text-lg",
            _ => "text-base" // medium
        });

        // Text color based on spinner color
        classes.Add(Color switch
        {
            "white" => "text-white",
            _ => "text-gray-600"
        });

        return string.Join(" ", classes);
    }

    private string AriaLabel => !string.IsNullOrEmpty(CustomAriaLabel) ? CustomAriaLabel : (!string.IsNullOrEmpty(Message) ? Message : "Loading content");
}
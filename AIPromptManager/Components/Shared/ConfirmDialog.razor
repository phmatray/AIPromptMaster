@if (IsVisible)
{
    <div class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50" 
         @onclick="HandleBackdropClick"
         role="dialog"
         aria-modal="true"
         aria-labelledby="dialog-title"
         aria-describedby="dialog-description">
        <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white" @onclick:stopPropagation="true">
            <div class="mt-3 text-center">
                <div class="mx-auto flex items-center justify-center h-12 w-12 rounded-full @GetIconBackgroundClass()">
                    @if (Type == ConfirmDialogType.Danger)
                    {
                        <i class="fas fa-exclamation-triangle h-6 w-6 text-red-600" aria-hidden="true"></i>
                    }
                    else if (Type == ConfirmDialogType.Warning)
                    {
                        <i class="fas fa-exclamation-triangle h-6 w-6 text-yellow-600" aria-hidden="true"></i>
                    }
                    else
                    {
                        <i class="fas fa-question-circle h-6 w-6 text-blue-600" aria-hidden="true"></i>
                    }
                </div>
                <h3 id="dialog-title" class="text-lg leading-6 font-medium text-gray-900 mt-4">@Title</h3>
                <div class="mt-2 px-7 py-3">
                    <p id="dialog-description" class="text-sm text-gray-500">
                        @Message
                    </p>
                </div>
                <div class="items-center px-4 py-3 space-x-3">
                    <button @onclick="HandleCancel" 
                            disabled="@IsProcessing"
                            class="px-4 py-2 bg-gray-500 text-white text-base font-medium rounded-md shadow-sm hover:bg-gray-600 focus:outline-none focus:ring-2 focus:ring-gray-300 focus:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed"
                            aria-label="Cancel action">
                        @CancelText
                    </button>
                    <button @onclick="HandleConfirm" 
                            disabled="@IsProcessing"
                            class="px-4 py-2 @GetConfirmButtonClass() text-white text-base font-medium rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed"
                            aria-label="Confirm action">
                        @if (IsProcessing)
                        {
                            <i class="fas fa-spinner fa-spin -ml-1 mr-2 h-4 w-4 text-white inline" aria-hidden="true"></i>
                            @ProcessingText
                        }
                        else
                        {
                            @ConfirmText
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public string Title { get; set; } = "Confirm Action";
    [Parameter] public string Message { get; set; } = "Are you sure you want to proceed?";
    [Parameter] public string ConfirmText { get; set; } = "Confirm";
    [Parameter] public string CancelText { get; set; } = "Cancel";
    [Parameter] public string ProcessingText { get; set; } = "Processing...";
    [Parameter] public ConfirmDialogType Type { get; set; } = ConfirmDialogType.Info;
    [Parameter] public bool IsProcessing { get; set; }
    [Parameter] public bool CloseOnBackdropClick { get; set; } = true;
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private async Task HandleConfirm()
    {
        await OnConfirm.InvokeAsync();
    }

    private async Task HandleCancel()
    {
        await OnCancel.InvokeAsync();
    }

    private async Task HandleBackdropClick()
    {
        if (CloseOnBackdropClick && !IsProcessing)
        {
            await HandleCancel();
        }
    }

    private string GetIconBackgroundClass()
    {
        return Type switch
        {
            ConfirmDialogType.Danger => "bg-red-100",
            ConfirmDialogType.Warning => "bg-yellow-100",
            _ => "bg-blue-100"
        };
    }

    private string GetConfirmButtonClass()
    {
        return Type switch
        {
            ConfirmDialogType.Danger => "bg-red-500 hover:bg-red-600 focus:ring-red-300",
            ConfirmDialogType.Warning => "bg-yellow-500 hover:bg-yellow-600 focus:ring-yellow-300",
            _ => "bg-blue-500 hover:bg-blue-600 focus:ring-blue-300"
        };
    }

    public enum ConfirmDialogType
    {
        Info,
        Warning,
        Danger
    }
}
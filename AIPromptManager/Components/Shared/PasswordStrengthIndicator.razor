@using System.Text.RegularExpressions

<div class="mt-2">
    <!-- Strength meter -->
    <div class="flex space-x-1 mb-2">
        <div class="flex-1 h-2 rounded-sm @GetBarClass(0)"></div>
        <div class="flex-1 h-2 rounded-sm @GetBarClass(1)"></div>
        <div class="flex-1 h-2 rounded-sm @GetBarClass(2)"></div>
        <div class="flex-1 h-2 rounded-sm @GetBarClass(3)"></div>
    </div>

    <!-- Strength label -->
    <div class="flex items-center justify-between mb-2">
        <span class="text-xs font-medium @GetLabelClass()">
            <i class="@GetIconClass() mr-1" aria-hidden="true"></i>
            @GetStrengthText()
        </span>
        <span class="text-xs text-gray-500">@_score/4</span>
    </div>

    <!-- Requirements checklist -->
    @if (ShowRequirements)
    {
        <div class="space-y-1">
            <div class="flex items-center text-xs">
                <i class="@GetRequirementIcon(_hasMinLength) mr-2" aria-hidden="true"></i>
                <span class="@GetRequirementTextClass(_hasMinLength)">At least 8 characters</span>
            </div>
            <div class="flex items-center text-xs">
                <i class="@GetRequirementIcon(_hasLowercase) mr-2" aria-hidden="true"></i>
                <span class="@GetRequirementTextClass(_hasLowercase)">Contains lowercase letter</span>
            </div>
            <div class="flex items-center text-xs">
                <i class="@GetRequirementIcon(_hasUppercase) mr-2" aria-hidden="true"></i>
                <span class="@GetRequirementTextClass(_hasUppercase)">Contains uppercase letter</span>
            </div>
            <div class="flex items-center text-xs">
                <i class="@GetRequirementIcon(_hasDigit) mr-2" aria-hidden="true"></i>
                <span class="@GetRequirementTextClass(_hasDigit)">Contains number</span>
            </div>
            <div class="flex items-center text-xs">
                <i class="@GetRequirementIcon(_hasSpecialChar) mr-2" aria-hidden="true"></i>
                <span class="@GetRequirementTextClass(_hasSpecialChar)">Contains special character</span>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string Password { get; set; } = string.Empty;
    [Parameter] public bool ShowRequirements { get; set; } = true;

    private int _score;
    private bool _hasMinLength;
    private bool _hasLowercase;
    private bool _hasUppercase;
    private bool _hasDigit;
    private bool _hasSpecialChar;

    protected override void OnParametersSet()
    {
        CalculatePasswordStrength();
    }

    private void CalculatePasswordStrength()
    {
        if (string.IsNullOrEmpty(Password))
        {
            _score = 0;
            _hasMinLength = false;
            _hasLowercase = false;
            _hasUppercase = false;
            _hasDigit = false;
            _hasSpecialChar = false;
            return;
        }

        _score = 0;
        
        // Check minimum length
        _hasMinLength = Password.Length >= 8;
        if (_hasMinLength) _score++;

        // Check for lowercase
        _hasLowercase = Regex.IsMatch(Password, @"[a-z]");
        if (_hasLowercase) _score++;

        // Check for uppercase
        _hasUppercase = Regex.IsMatch(Password, @"[A-Z]");
        if (_hasUppercase) _score++;

        // Check for digits
        _hasDigit = Regex.IsMatch(Password, @"\d");
        if (_hasDigit) _score++;

        // Check for special characters
        _hasSpecialChar = Regex.IsMatch(Password, @"[\W_]");
        if (_hasSpecialChar && _score < 4) _score++;
    }

    private string GetBarClass(int index)
    {
        if (_score > index)
        {
            return _score switch
            {
                1 => "bg-red-400",
                2 => "bg-yellow-400",
                3 => "bg-blue-400",
                4 => "bg-green-500",
                _ => "bg-gray-200"
            };
        }
        return "bg-gray-200";
    }

    private string GetLabelClass()
    {
        return _score switch
        {
            0 => "text-gray-500",
            1 => "text-red-600",
            2 => "text-yellow-600",
            3 => "text-blue-600",
            4 => "text-green-600",
            _ => "text-gray-500"
        };
    }

    private string GetIconClass()
    {
        return _score switch
        {
            0 => "fas fa-minus-circle text-gray-400",
            1 => "fas fa-exclamation-triangle text-red-500",
            2 => "fas fa-exclamation-circle text-yellow-500",
            3 => "fas fa-check-circle text-blue-500",
            4 => "fas fa-check-circle text-green-500",
            _ => "fas fa-minus-circle text-gray-400"
        };
    }

    private string GetStrengthText()
    {
        if (string.IsNullOrEmpty(Password))
            return "Enter a password";
            
        return _score switch
        {
            0 => "Too weak",
            1 => "Weak",
            2 => "Fair",
            3 => "Good",
            4 => "Strong",
            _ => "Unknown"
        };
    }

    private string GetRequirementIcon(bool met)
    {
        return met ? "fas fa-check text-green-500" : "fas fa-times text-gray-400";
    }

    private string GetRequirementTextClass(bool met)
    {
        return met ? "text-green-600" : "text-gray-500";
    }
}
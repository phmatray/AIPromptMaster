@if (IsVisible)
{
    <div class="fixed top-4 right-4 z-50 max-w-sm w-full">
        <div class="@GetToastClasses() rounded-lg shadow-lg p-4 transition-all duration-300 ease-in-out">
            <div class="flex items-start">
                <div class="flex-shrink-0">
                    @if (Type == ToastType.Success)
                    {
                        <svg class="h-5 w-5 text-green-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                        </svg>
                    }
                    else if (Type == ToastType.Error)
                    {
                        <svg class="h-5 w-5 text-red-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                        </svg>
                    }
                    else if (Type == ToastType.Warning)
                    {
                        <svg class="h-5 w-5 text-yellow-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                        </svg>
                    }
                    else
                    {
                        <svg class="h-5 w-5 text-blue-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                        </svg>
                    }
                </div>
                <div class="ml-3 w-0 flex-1">
                    @if (!string.IsNullOrEmpty(Title))
                    {
                        <p class="text-sm font-medium @GetTitleTextClass()">@Title</p>
                    }
                    @if (!string.IsNullOrEmpty(Message))
                    {
                        <p class="@(string.IsNullOrEmpty(Title) ? "text-sm font-medium" : "mt-1 text-sm") @GetMessageTextClass()">@Message</p>
                    }
                </div>
                <div class="ml-4 flex-shrink-0 flex">
                    <button type="button" @onclick="Hide" class="@GetCloseButtonClass() rounded-md inline-flex text-gray-400 hover:text-gray-500 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                        <span class="sr-only">Close</span>
                        <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
                        </svg>
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Message { get; set; }
    [Parameter] public ToastType Type { get; set; } = ToastType.Info;
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnHide { get; set; }
    [Parameter] public int AutoHideDelayMs { get; set; } = 5000;

    private Timer? _autoHideTimer;

    protected override void OnParametersSet()
    {
        if (IsVisible && AutoHideDelayMs > 0)
        {
            _autoHideTimer?.Dispose();
            _autoHideTimer = new Timer(async _ => await AutoHide(), null, AutoHideDelayMs, Timeout.Infinite);
        }
    }

    private async Task Hide()
    {
        IsVisible = false;
        _autoHideTimer?.Dispose();
        await OnHide.InvokeAsync();
        StateHasChanged();
    }

    private async Task AutoHide()
    {
        await InvokeAsync(async () => await Hide());
    }

    private string GetToastClasses()
    {
        return Type switch
        {
            ToastType.Success => "bg-green-50 border border-green-200",
            ToastType.Error => "bg-red-50 border border-red-200",
            ToastType.Warning => "bg-yellow-50 border border-yellow-200",
            _ => "bg-blue-50 border border-blue-200"
        };
    }

    private string GetTitleTextClass()
    {
        return Type switch
        {
            ToastType.Success => "text-green-800",
            ToastType.Error => "text-red-800",
            ToastType.Warning => "text-yellow-800",
            _ => "text-blue-800"
        };
    }

    private string GetMessageTextClass()
    {
        return Type switch
        {
            ToastType.Success => "text-green-700",
            ToastType.Error => "text-red-700",
            ToastType.Warning => "text-yellow-700",
            _ => "text-blue-700"
        };
    }

    private string GetCloseButtonClass()
    {
        return Type switch
        {
            ToastType.Success => "bg-green-50 text-green-500 hover:bg-green-100 focus:ring-green-600 focus:ring-offset-green-50",
            ToastType.Error => "bg-red-50 text-red-500 hover:bg-red-100 focus:ring-red-600 focus:ring-offset-red-50",
            ToastType.Warning => "bg-yellow-50 text-yellow-500 hover:bg-yellow-100 focus:ring-yellow-600 focus:ring-offset-yellow-50",
            _ => "bg-blue-50 text-blue-500 hover:bg-blue-100 focus:ring-blue-600 focus:ring-offset-blue-50"
        };
    }

    public void Dispose()
    {
        _autoHideTimer?.Dispose();
    }

    public enum ToastType
    {
        Info,
        Success,
        Warning,
        Error
    }
}
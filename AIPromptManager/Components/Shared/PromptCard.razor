@using AIPromptManager.Models
@using System.Text.RegularExpressions
@inject IJSRuntime JSRuntime

<article class="bg-white rounded-lg shadow-md border border-gray-200 p-6 hover:shadow-lg transition-shadow duration-200 focus-within:ring-2 focus-within:ring-blue-500 focus-within:ring-offset-2" 
         tabindex="0" 
         @onkeydown="HandleCardKeyDown"
         role="article"
         aria-labelledby="prompt-title-@Prompt.Id"
         aria-describedby="prompt-description-@Prompt.Id">
    <!-- Header with Title and Actions -->
    <div class="flex justify-between items-start mb-3">
        <h3 id="prompt-title-@Prompt.Id" class="text-lg font-semibold text-gray-900 truncate flex-1 mr-4">
            @HighlightSearchTerm(Prompt.Title)
        </h3>
        <div class="flex space-x-2 flex-shrink-0" role="toolbar" aria-label="Prompt actions">
            <!-- Copy Button -->
            <button @onclick="CopyToClipboard" 
                    @onkeydown="@((e) => HandleButtonKeyDown(e, CopyToClipboard))"
                    class="p-2 text-gray-500 hover:text-blue-600 hover:bg-blue-50 rounded-md transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
                    title="Copy prompt to clipboard (Ctrl+C)"
                    aria-label="Copy prompt to clipboard"
                    aria-describedby="@(showCopySuccess ? $"copy-success-{Prompt.Id}" : null)"
                    tabindex="0">
                @if (showCopySuccess)
                {
                    <svg class="w-4 h-4 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                    </svg>
                }
                else
                {
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                    </svg>
                }
            </button>
            
            <!-- Edit Button -->
            <button @onclick="() => OnEdit.InvokeAsync(Prompt)" 
                    @onkeydown="@((e) => HandleButtonKeyDown(e, () => OnEdit.InvokeAsync(Prompt)))"
                    class="p-2 text-gray-500 hover:text-blue-600 hover:bg-blue-50 rounded-md transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
                    title="Edit prompt (E)"
                    aria-label="Edit prompt"
                    tabindex="0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                </svg>
            </button>
            
            <!-- Delete Button -->
            <button @onclick="() => OnDelete.InvokeAsync(Prompt)" 
                    @onkeydown="@((e) => HandleButtonKeyDown(e, () => OnDelete.InvokeAsync(Prompt)))"
                    class="p-2 text-gray-500 hover:text-red-600 hover:bg-red-50 rounded-md transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2"
                    title="Delete prompt (Delete)"
                    aria-label="Delete prompt"
                    tabindex="0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                </svg>
            </button>
        </div>
    </div>

    <!-- Description -->
    @if (!string.IsNullOrWhiteSpace(Prompt.Description))
    {
        <p id="prompt-description-@Prompt.Id" class="text-gray-600 text-sm mb-4 line-clamp-2">
            @HighlightSearchTerm(Prompt.Description)
        </p>
    }

    <!-- Content Preview -->
    <div class="mb-4">
        <div class="bg-gray-50 rounded-md p-3 border">
            <p class="text-sm text-gray-700 font-mono whitespace-pre-wrap line-clamp-3">
                @HighlightSearchTerm(Prompt.Content)
            </p>
        </div>
    </div>

    <!-- Tags -->
    @if (Prompt.Tags.Any())
    {
        <div class="flex flex-wrap gap-2 mb-3">
            @foreach (var tag in Prompt.Tags)
            {
                <button @onclick="() => OnTagClick.InvokeAsync(tag.Name)"
                        @onkeydown="@((e) => HandleButtonKeyDown(e, () => OnTagClick.InvokeAsync(tag.Name)))"
                        class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800 hover:bg-blue-200 hover:shadow-sm cursor-pointer transition-all duration-200 select-none focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
                        title="Click to filter by this tag"
                        aria-label="Filter by tag @tag.Name"
                        tabindex="0">
                    @HighlightSearchTerm(tag.Name)
                </button>
            }
        </div>
    }

    <!-- Footer with Metadata -->
    <div class="flex justify-between items-center text-xs text-gray-500 pt-3 border-t border-gray-100">
        <span>Created: @Prompt.CreatedAt.ToString("MMM dd, yyyy")</span>
        @if (Prompt.UpdatedAt != Prompt.CreatedAt)
        {
            <span>Updated: @Prompt.UpdatedAt.ToString("MMM dd, yyyy")</span>
        }
    </div>

    <!-- Copy Success Message -->
    @if (showCopySuccess)
    {
        <div id="copy-success-@Prompt.Id" class="mt-2 text-xs text-green-600 font-medium" role="status" aria-live="polite">
            Copied to clipboard!
        </div>
    }
</article>

@code {
    [Parameter] public Prompt Prompt { get; set; } = new();
    [Parameter] public EventCallback<Prompt> OnEdit { get; set; }
    [Parameter] public EventCallback<Prompt> OnDelete { get; set; }
    [Parameter] public EventCallback<string> OnTagClick { get; set; }
    [Parameter] public string SearchTerm { get; set; } = string.Empty;

    private bool showCopySuccess = false;

    private async Task CopyToClipboard()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", Prompt.Content);
            showCopySuccess = true;
            StateHasChanged();
            
            // Hide success message after 2 seconds
            await Task.Delay(2000);
            showCopySuccess = false;
            StateHasChanged();
        }
        catch (Exception)
        {
            // Fallback for browsers that don't support clipboard API
            await JSRuntime.InvokeVoidAsync("alert", "Copy to clipboard failed. Please copy manually.");
        }
    }

    private async Task HandleCardKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key.ToLower())
        {
            case "c":
                if (e.CtrlKey)
                {
                    await CopyToClipboard();
                }
                break;
            case "e":
                await OnEdit.InvokeAsync(Prompt);
                break;
            case "delete":
                await OnDelete.InvokeAsync(Prompt);
                break;
            case "enter":
            case " ":
                // Focus first interactive element (copy button)
                await JSRuntime.InvokeVoidAsync("focusElement", $"button[aria-label='Copy prompt to clipboard']");
                break;
        }
    }

    private async Task HandleButtonKeyDown(KeyboardEventArgs e, Func<Task> action)
    {
        if (e.Key == "Enter" || e.Key == " ")
        {
            await action();
        }
    }

    private MarkupString HighlightSearchTerm(string text)
    {
        if (string.IsNullOrWhiteSpace(SearchTerm) || string.IsNullOrWhiteSpace(text))
        {
            return new MarkupString(System.Web.HttpUtility.HtmlEncode(text));
        }

        var escapedText = System.Web.HttpUtility.HtmlEncode(text);
        var escapedSearchTerm = System.Web.HttpUtility.HtmlEncode(SearchTerm);
        
        // Case-insensitive highlighting with better contrast
        var highlightedText = Regex.Replace(
            escapedText,
            Regex.Escape(escapedSearchTerm),
            match => $"<mark class=\"bg-yellow-100 text-yellow-900 px-1 rounded font-medium\">{match.Value}</mark>",
            RegexOptions.IgnoreCase
        );

        return new MarkupString(highlightedText);
    }
}

<style>
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    
    .line-clamp-3 {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>
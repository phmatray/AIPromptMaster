@using AIPromptManager.Models
@using AIPromptManager.Services
@inject IPromptService PromptService

<CustomErrorBoundary>
    <div class="w-full">
    @if (IsLoading)
    {
        <!-- Loading State -->
        <LoadingSpinner Message="Loading prompts..." CenterVertically="true" />
    }
    else if (!Prompts.Any())
    {
        <!-- Empty State -->
        <div class="text-center py-12">
            <i class="fas fa-file-alt fa-3x text-gray-400" aria-hidden="true"></i>
            <h3 class="mt-2 text-sm font-medium text-gray-900">No prompts found</h3>
            <p class="mt-1 text-sm text-gray-500">
                @if (!string.IsNullOrEmpty(SearchTerm))
                {
                    <span>No prompts match your search criteria.</span>
                }
                else
                {
                    <span>Get started by creating your first prompt.</span>
                }
            </p>
            @if (string.IsNullOrEmpty(SearchTerm))
            {
                <div class="mt-6">
                    <button @onclick="OnCreateNew" 
                            class="inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                        <i class="fas fa-plus -ml-1 mr-2" aria-hidden="true"></i>
                        Create your first prompt
                    </button>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Prompts Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6" 
             role="grid" 
             aria-label="Prompts list">
            @foreach (var prompt in CurrentPagePrompts)
            {
                <PromptCard Prompt="prompt" 
                           SearchTerm="SearchTerm"
                           OnEdit="HandleEdit" 
                           OnDelete="HandleDelete" 
                           OnTagClick="HandleTagClick" />
            }
        </div>

        <!-- Pagination -->
        @if (TotalPages > 1)
        {
            <div class="mt-8 flex items-center justify-between border-t border-gray-200 bg-white px-4 py-3 sm:px-6">
                <div class="flex flex-1 justify-between sm:hidden">
                    <!-- Mobile Pagination -->
                    <button @onclick="PreviousPage" 
                            disabled="@(_currentPage == 1)"
                            class="relative inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed"
                            aria-label="Go to previous page">
                        Previous
                    </button>
                    <button @onclick="NextPage" 
                            disabled="@(_currentPage == TotalPages)"
                            class="relative ml-3 inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed"
                            aria-label="Go to next page">
                        Next
                    </button>
                </div>
                <div class="hidden sm:flex sm:flex-1 sm:items-center sm:justify-between">
                    <div>
                        <p class="text-sm text-gray-700">
                            Showing <span class="font-medium">@StartIndex</span> to <span class="font-medium">@EndIndex</span> of <span class="font-medium">@TotalPrompts</span> results
                        </p>
                    </div>
                    <div>
                        <nav class="isolate inline-flex -space-x-px rounded-md shadow-sm" aria-label="Pagination">
                            <!-- Previous Button -->
                            <button @onclick="PreviousPage" 
                                    disabled="@(_currentPage == 1)"
                                    class="relative inline-flex items-center rounded-l-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed"
                                    aria-label="Go to previous page">
                                <span class="sr-only">Previous</span>
                                <i class="fas fa-chevron-left" aria-hidden="true"></i>
                            </button>

                            <!-- Page Numbers -->
                            @for (int i = Math.Max(1, _currentPage - 2); i <= Math.Min(TotalPages, _currentPage + 2); i++)
                            {
                                int pageNum = i;
                                <button @onclick="() => GoToPage(pageNum)" 
                                        class="@GetPageButtonClass(pageNum)"
                                        aria-label="Go to page @pageNum"
                                        aria-current="@(pageNum == _currentPage ? "page" : null)">
                                    @pageNum
                                </button>
                            }

                            <!-- Next Button -->
                            <button @onclick="NextPage" 
                                    disabled="@(_currentPage == TotalPages)"
                                    class="relative inline-flex items-center rounded-r-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed"
                                    aria-label="Go to next page">
                                <span class="sr-only">Next</span>
                                <i class="fas fa-chevron-right" aria-hidden="true"></i>
                            </button>
                        </nav>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter] public IEnumerable<Prompt> Prompts { get; set; } = new List<Prompt>();
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public string SearchTerm { get; set; } = string.Empty;
    [Parameter] public EventCallback<Prompt> OnEdit { get; set; }
    [Parameter] public EventCallback<Prompt> OnDelete { get; set; }
    [Parameter] public EventCallback<string> OnTagClick { get; set; }
    [Parameter] public EventCallback OnCreateNew { get; set; }
    [Parameter] public int PageSize { get; set; } = 12;

    private int _currentPage = 1;
    private int TotalPrompts => Prompts.Count();
    private int TotalPages => (int)Math.Ceiling((double)TotalPrompts / PageSize);
    private int StartIndex => (_currentPage - 1) * PageSize + 1;
    private int EndIndex => Math.Min(_currentPage * PageSize, TotalPrompts);

    private IEnumerable<Prompt> CurrentPagePrompts => 
        Prompts.Skip((_currentPage - 1) * PageSize).Take(PageSize);

    protected override void OnParametersSet()
    {
        // Reset to first page when prompts change (e.g., after search)
        if (_currentPage > TotalPages && TotalPages > 0)
        {
            _currentPage = 1;
        }
    }

    private void PreviousPage()
    {
        if (_currentPage > 1)
        {
            _currentPage--;
        }
    }

    private void NextPage()
    {
        if (_currentPage < TotalPages)
        {
            _currentPage++;
        }
    }

    private void GoToPage(int page)
    {
        if (page >= 1 && page <= TotalPages)
        {
            _currentPage = page;
        }
    }

    private string GetPageButtonClass(int pageNum)
    {
        var baseClass = "relative inline-flex items-center px-4 py-2 text-sm font-semibold ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2";
        
        if (pageNum == _currentPage)
        {
            return baseClass + " z-10 bg-blue-600 text-white";
        }
        
        return baseClass + " text-gray-900";
    }

    private async Task HandleEdit(Prompt prompt)
    {
        await OnEdit.InvokeAsync(prompt);
    }

    private async Task HandleDelete(Prompt prompt)
    {
        await OnDelete.InvokeAsync(prompt);
    }

    private async Task HandleTagClick(string tagName)
    {
        await OnTagClick.InvokeAsync(tagName);
    }
}
</CustomErrorBoundary>
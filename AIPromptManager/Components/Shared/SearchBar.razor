@using System.Timers
@implements IDisposable

<div class="relative w-full max-w-lg mx-auto">
    <div class="relative">
        <!-- Search Input -->
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <svg class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
        </div>
        
        <input @bind="searchText" 
               @bind:event="oninput"
               @onkeydown="HandleKeyDown"
               type="text" 
               placeholder="@Placeholder"
               class="block w-full pl-10 pr-12 py-3 border border-gray-300 rounded-lg leading-5 bg-white placeholder-gray-500 focus:outline-none focus:placeholder-gray-400 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
               aria-label="Search prompts" />

        <!-- Clear Button -->
        @if (!string.IsNullOrEmpty(_searchText))
        {
            <div class="absolute inset-y-0 right-0 pr-3 flex items-center">
                <button @onclick="ClearSearch" 
                        type="button"
                        class="h-5 w-5 text-gray-400 hover:text-gray-600 focus:outline-none focus:text-gray-600"
                        aria-label="Clear search">
                    <svg fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
                    </svg>
                </button>
            </div>
        }
    </div>

    <!-- Search Status -->
    @if (IsSearching)
    {
        <div class="absolute top-full left-0 right-0 mt-1 bg-white border border-gray-200 rounded-md shadow-sm p-3 z-10">
            <div class="flex items-center text-sm text-gray-600">
                <div class="animate-spin rounded-full h-4 w-4 border-b-2 border-blue-600 mr-2"></div>
                Searching...
            </div>
        </div>
    }
    else if (!string.IsNullOrEmpty(CurrentSearchTerm) && SearchResultCount == 0)
    {
        <div class="absolute top-full left-0 right-0 mt-1 bg-white border border-gray-200 rounded-md shadow-sm p-3 z-10">
            <div class="text-sm text-gray-600">
                <div class="flex items-center">
                    <svg class="h-4 w-4 text-gray-400 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    No results found for "<span class="font-medium">@CurrentSearchTerm</span>"
                </div>
                <div class="mt-1 text-xs text-gray-500">
                    Try adjusting your search terms or browse all prompts
                </div>
            </div>
        </div>
    }
    else if (!string.IsNullOrEmpty(CurrentSearchTerm) && SearchResultCount > 0)
    {
        <div class="mt-2 text-sm text-gray-600">
            Found @SearchResultCount @(SearchResultCount == 1 ? "prompt" : "prompts") matching "<span class="font-medium">@CurrentSearchTerm</span>"
        </div>
    }
</div>

@code {
    [Parameter] public string SearchTerm { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> SearchTermChanged { get; set; }
    [Parameter] public EventCallback<string> OnSearch { get; set; }
    [Parameter] public EventCallback OnClear { get; set; }
    [Parameter] public bool IsSearching { get; set; } = false;
    [Parameter] public int SearchResultCount { get; set; } = 0;
    [Parameter] public int DebounceDelay { get; set; } = 300; // milliseconds
    [Parameter] public string Placeholder { get; set; } = "Search prompts by title, description, or content...";

    private string _searchText = string.Empty;
    private string CurrentSearchTerm = string.Empty;
    private Timer? debounceTimer;

    private string searchText
    {
        get => _searchText;
        set
        {
            if (_searchText != value)
            {
                _searchText = value;
                DebounceSearch();
            }
        }
    }

    protected override void OnParametersSet()
    {
        if (_searchText != SearchTerm)
        {
            _searchText = SearchTerm;
            CurrentSearchTerm = SearchTerm;
        }
    }

    protected override void OnInitialized()
    {
        debounceTimer = new Timer(DebounceDelay);
        debounceTimer.Elapsed += OnDebounceTimerElapsed;
        debounceTimer.AutoReset = false;
    }

    private void DebounceSearch()
    {
        debounceTimer?.Stop();
        debounceTimer?.Start();
    }

    private async void OnDebounceTimerElapsed(object? sender, ElapsedEventArgs e)
    {
        await InvokeAsync(async () =>
        {
            var trimmedSearch = _searchText.Trim();
            
            if (trimmedSearch != CurrentSearchTerm)
            {
                CurrentSearchTerm = trimmedSearch;
                await SearchTermChanged.InvokeAsync(trimmedSearch);
                
                if (string.IsNullOrEmpty(trimmedSearch))
                {
                    await OnClear.InvokeAsync();
                }
                else
                {
                    await OnSearch.InvokeAsync(trimmedSearch);
                }
                
                StateHasChanged();
            }
        });
    }

    private async Task ClearSearch()
    {
        _searchText = string.Empty;
        CurrentSearchTerm = string.Empty;
        debounceTimer?.Stop();
        await SearchTermChanged.InvokeAsync(string.Empty);
        await OnClear.InvokeAsync();
        StateHasChanged();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await ClearSearch();
        }
        else if (e.Key == "Enter")
        {
            // Trigger immediate search on Enter
            debounceTimer?.Stop();
            var trimmedSearch = _searchText.Trim();
            
            if (trimmedSearch != CurrentSearchTerm)
            {
                CurrentSearchTerm = trimmedSearch;
                await SearchTermChanged.InvokeAsync(trimmedSearch);
                
                if (string.IsNullOrEmpty(trimmedSearch))
                {
                    await OnClear.InvokeAsync();
                }
                else
                {
                    await OnSearch.InvokeAsync(trimmedSearch);
                }
                
                StateHasChanged();
            }
        }
    }

    public void Dispose()
    {
        debounceTimer?.Dispose();
    }
}
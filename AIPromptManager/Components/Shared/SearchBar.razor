@using System.Timers
@implements IDisposable

<div class="relative w-full max-w-lg mx-auto">
    <div class="relative">
        <!-- Search Input -->
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <i class="fas fa-search h-5 w-5 text-gray-400" aria-hidden="true"></i>
        </div>
        
        <input @bind="SearchText" 
               @bind:event="oninput"
               @onkeydown="HandleKeyDown"
               type="text" 
               placeholder="@Placeholder"
               class="block w-full pl-10 pr-12 py-3 border border-gray-300 rounded-lg leading-5 bg-white placeholder-gray-500 focus:outline-none focus:placeholder-gray-400 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
               aria-label="Search prompts"
               aria-describedby="search-help"
               role="searchbox" />

        <!-- Clear Button -->
        @if (!string.IsNullOrEmpty(_searchText))
        {
            <div class="absolute inset-y-0 right-0 pr-3 flex items-center">
                <button @onclick="ClearSearch" 
                        type="button"
                        class="h-5 w-5 text-gray-400 hover:text-gray-600 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 rounded-sm"
                        aria-label="Clear search"
                        title="Clear search (Escape)"
                        tabindex="0">
                    <i class="fas fa-times" aria-hidden="true"></i>
                </button>
            </div>
        }
    </div>

    <!-- Search Status -->
    @if (IsSearching)
    {
        <div class="absolute top-full left-0 right-0 mt-1 bg-white border border-gray-200 rounded-md shadow-sm p-3 z-10">
            <LoadingSpinner Size="small" ShowInline="true" Message="Searching..." />
        </div>
    }
    else if (!string.IsNullOrEmpty(_currentSearchTerm) && SearchResultCount == 0)
    {
        <div class="absolute top-full left-0 right-0 mt-1 bg-white border border-gray-200 rounded-md shadow-sm p-3 z-10">
            <div class="text-sm text-gray-600">
                <div class="flex items-center">
                    <i class="fas fa-file-alt h-4 w-4 text-gray-400 mr-2" aria-hidden="true"></i>
                    No results found for "<span class="font-medium">@_currentSearchTerm</span>"
                </div>
                <div class="mt-1 text-xs text-gray-500">
                    Try adjusting your search terms or browse all prompts
                </div>
            </div>
        </div>
    }
    else if (!string.IsNullOrEmpty(_currentSearchTerm) && SearchResultCount > 0)
    {
        <div class="mt-2 text-sm text-gray-600" role="status" aria-live="polite">
            Found @SearchResultCount @(SearchResultCount == 1 ? "prompt" : "prompts") matching "<span class="font-medium">@_currentSearchTerm</span>"
        </div>
    }
    
    <!-- Hidden help text for screen readers -->
    <div id="search-help" class="sr-only">
        Use Enter to search immediately, Escape to clear search
    </div>
</div>

@code {
    [Parameter] public string SearchTerm { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> SearchTermChanged { get; set; }
    [Parameter] public EventCallback<string> OnSearch { get; set; }
    [Parameter] public EventCallback OnClear { get; set; }
    [Parameter] public bool IsSearching { get; set; }
    [Parameter] public int SearchResultCount { get; set; }
    [Parameter] public int DebounceDelay { get; set; } = 300; // milliseconds
    [Parameter] public string Placeholder { get; set; } = "Search prompts by title, description, or content...";

    private string _searchText = string.Empty;
    private string _currentSearchTerm = string.Empty;
    private Timer? _debounceTimer;

    private string SearchText
    {
        get => _searchText;
        set
        {
            if (_searchText != value)
            {
                _searchText = value;
                DebounceSearch();
            }
        }
    }

    protected override void OnParametersSet()
    {
        if (_searchText != SearchTerm)
        {
            _searchText = SearchTerm;
            _currentSearchTerm = SearchTerm;
        }
    }

    protected override void OnInitialized()
    {
        _debounceTimer = new Timer(DebounceDelay);
        _debounceTimer.Elapsed += OnDebounceTimerElapsed;
        _debounceTimer.AutoReset = false;
    }

    private void DebounceSearch()
    {
        _debounceTimer?.Stop();
        _debounceTimer?.Start();
    }

    private async void OnDebounceTimerElapsed(object? sender, ElapsedEventArgs e)
    {
        await InvokeAsync(async () =>
        {
            var trimmedSearch = _searchText.Trim();
            
            if (trimmedSearch != _currentSearchTerm)
            {
                _currentSearchTerm = trimmedSearch;
                await SearchTermChanged.InvokeAsync(trimmedSearch);
                
                if (string.IsNullOrEmpty(trimmedSearch))
                {
                    await OnClear.InvokeAsync();
                }
                else
                {
                    await OnSearch.InvokeAsync(trimmedSearch);
                }
                
                StateHasChanged();
            }
        });
    }

    private async Task ClearSearch()
    {
        _searchText = string.Empty;
        _currentSearchTerm = string.Empty;
        _debounceTimer?.Stop();
        await SearchTermChanged.InvokeAsync(string.Empty);
        await OnClear.InvokeAsync();
        StateHasChanged();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await ClearSearch();
        }
        else if (e.Key == "Enter")
        {
            // Trigger immediate search on Enter
            _debounceTimer?.Stop();
            var trimmedSearch = _searchText.Trim();
            
            if (trimmedSearch != _currentSearchTerm)
            {
                _currentSearchTerm = trimmedSearch;
                await SearchTermChanged.InvokeAsync(trimmedSearch);
                
                if (string.IsNullOrEmpty(trimmedSearch))
                {
                    await OnClear.InvokeAsync();
                }
                else
                {
                    await OnSearch.InvokeAsync(trimmedSearch);
                }
                
                StateHasChanged();
            }
        }
    }

    public void Dispose()
    {
        _debounceTimer?.Dispose();
    }
}
@using AIPromptManager.Models
@using AIPromptManager.Services
@using System.ComponentModel.DataAnnotations
@using static AIPromptManager.Components.Shared.ConfirmDialog
@inject IPromptService PromptService
@inject IValidationService ValidationService

<div class="max-w-4xl mx-auto">
    <EditForm Model="@_promptModel" OnValidSubmit="@HandleValidSubmit" class="space-y-6">
        <DataAnnotationsValidator />
        
        <!-- Form Header -->
        <div class="bg-white px-6 py-4 border-b border-gray-200">
            <h2 class="text-xl font-semibold text-gray-900">
                @(IsEditMode ? "Edit Prompt" : "Create New Prompt")
            </h2>
            <p class="mt-1 text-sm text-gray-600">
                @(IsEditMode ? "Update your prompt details below." : "Fill in the details to create a new prompt.")
            </p>
        </div>

        <!-- Form Content -->
        <div class="bg-white px-6 py-6 space-y-6">
            <!-- Title Field -->
            <div class="space-y-2">
                <label for="title" class="block text-sm font-medium text-gray-700">
                    Title <span class="text-red-500">*</span>
                </label>
                <InputText id="title" 
                          @bind-Value="_promptModel.Title" 
                          class="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
                          placeholder="Enter a descriptive title for your prompt"
                          maxlength="200" />
                <ValidationMessage For="@(() => _promptModel.Title)" class="text-sm text-red-600" />
                <p class="text-xs text-gray-500">@(_promptModel.Title.Length)/200 characters</p>
            </div>

            <!-- Description Field -->
            <div class="space-y-2">
                <label for="description" class="block text-sm font-medium text-gray-700">
                    Description
                </label>
                <InputTextArea id="description" 
                              @bind-Value="_promptModel.Description" 
                              rows="3"
                              class="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm resize-vertical"
                              placeholder="Optional description to help you remember what this prompt is for"
                              maxlength="500" />
                <ValidationMessage For="@(() => _promptModel.Description)" class="text-sm text-red-600" />
                <p class="text-xs text-gray-500">@(_promptModel.Description?.Length ?? 0)/500 characters</p>
            </div>

            <!-- Content Field -->
            <div class="space-y-2">
                <label for="content" class="block text-sm font-medium text-gray-700">
                    Prompt Content <span class="text-red-500">*</span>
                </label>
                <InputTextArea id="content" 
                              @bind-Value="_promptModel.Content" 
                              rows="8"
                              class="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm font-mono text-sm resize-vertical"
                              placeholder="Enter your AI prompt here..." />
                <ValidationMessage For="@(() => _promptModel.Content)" class="text-sm text-red-600" />
                <p class="text-xs text-gray-500">
                    This is the actual prompt text that will be copied to your clipboard.
                </p>
            </div>

            <!-- Tags Field -->
            <TagInput @bind-SelectedTags="_selectedTags" 
                     ErrorMessage="@_tagErrorMessage" />
        </div>

        <!-- Form Actions -->
        <div class="bg-gray-50 px-6 py-4 flex flex-col sm:flex-row sm:justify-between sm:items-center space-y-3 sm:space-y-0">
            <!-- Cancel Button -->
            <button type="button" 
                    @onclick="HandleCancel"
                    class="w-full sm:w-auto px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors duration-200">
                Cancel
            </button>

            <!-- Submit Button -->
            <div class="flex space-x-3">
                @if (IsEditMode)
                {
                    <button type="button" 
                            @onclick="ShowDeleteConfirmation"
                            class="px-4 py-2 text-sm font-medium text-white bg-red-600 border border-transparent rounded-md shadow-sm hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition-colors duration-200"
                            disabled="@(_isSubmitting || _isDeletingPrompt)">
                        Delete
                    </button>
                }
                
                <button type="submit" 
                        class="px-4 py-2 text-sm font-medium text-white bg-blue-600 border border-transparent rounded-md shadow-sm hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 disabled:opacity-50 disabled:cursor-not-allowed transition-colors duration-200"
                        disabled="@_isSubmitting">
                    @if (_isSubmitting)
                    {
                        <LoadingSpinner Size="small" Color="white" ShowInline="true" Message="@(IsEditMode ? "Updating..." : "Creating...")" />
                    }
                    else
                    {
                        @(IsEditMode ? "Update Prompt" : "Create Prompt")
                    }
                </button>
            </div>
        </div>

        <!-- Validation Summary -->
        <ValidationSummary class="mt-4 p-4 bg-red-50 border border-red-200 rounded-md" />
    </EditForm>

    <!-- Delete Confirmation Dialog -->
    <ConfirmDialog IsVisible="_showDeleteConfirmation"
                   Title="Delete Prompt"
                   Message="@GetDeleteConfirmationMessage()"
                   ConfirmText="Delete"
                   CancelText="Cancel"
                   ProcessingText="Deleting..."
                   Type="ConfirmDialogType.Danger"
                   IsProcessing="_isDeletingPrompt"
                   CloseOnBackdropClick="true"
                   OnConfirm="ConfirmDelete"
                   OnCancel="CancelDelete" />
</div>

@code {
    [Parameter] public Prompt? ExistingPrompt { get; set; }
    [Parameter] public EventCallback<Prompt> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback<Prompt> OnDelete { get; set; }
    [Parameter] public EventCallback<string> OnError { get; set; }

    private PromptFormModel _promptModel = new();
    private List<string> _selectedTags = new();
    private string? _tagErrorMessage;
    private bool _isSubmitting;
    
    // Delete confirmation state
    private bool _showDeleteConfirmation;
    private bool _isDeletingPrompt;

    public bool IsEditMode => ExistingPrompt != null;

    protected override void OnParametersSet()
    {
        if (ExistingPrompt != null)
        {
            // Populate form with existing prompt data
            _promptModel = new PromptFormModel
            {
                Id = ExistingPrompt.Id,
                Title = ExistingPrompt.Title,
                Description = ExistingPrompt.Description,
                Content = ExistingPrompt.Content,
                RowVersion = ExistingPrompt.RowVersion
            };
            
            _selectedTags = ExistingPrompt.Tags.Select(t => t.Name).ToList();
        }
        else
        {
            // Reset form for new prompt
            _promptModel = new PromptFormModel();
            _selectedTags = new List<string>();
        }
        
        _tagErrorMessage = null;
    }

    private async Task HandleValidSubmit()
    {
        if (_isSubmitting) return;

        _isSubmitting = true;
        _tagErrorMessage = null;

        try
        {
            // Additional client-side validation before submission
            var sanitizedTags = ValidationService.SanitizeTags(_selectedTags).ToList();
            
            // Validate each tag
            foreach (var tagName in sanitizedTags)
            {
                var tagValidation = ValidationService.ValidateTagName(tagName);
                if (!tagValidation.IsValid)
                {
                    _tagErrorMessage = $"Invalid tag '{tagName}': {string.Join("; ", tagValidation.Errors)}";
                    return;
                }
            }

            // Create or update prompt
            var prompt = new Prompt
            {
                Id = _promptModel.Id,
                Title = ValidationService.SanitizeInput(_promptModel.Title),
                Description = string.IsNullOrWhiteSpace(_promptModel.Description) ? null : ValidationService.SanitizeInput(_promptModel.Description),
                Content = ValidationService.SanitizeInput(_promptModel.Content),
                Tags = sanitizedTags.Select(tagName => new Tag { Name = tagName }).ToList(),
                RowVersion = _promptModel.RowVersion
            };

            // Client-side validation of the complete prompt
            var promptValidation = ValidationService.ValidatePrompt(prompt);
            if (!promptValidation.IsValid)
            {
                var errorMessage = string.Join("; ", promptValidation.Errors);
                _tagErrorMessage = $"Validation failed: {errorMessage}";
                await OnError.InvokeAsync(errorMessage);
                return;
            }

            Prompt savedPrompt;
            if (IsEditMode)
            {
                prompt.CreatedAt = ExistingPrompt!.CreatedAt;
                prompt.UpdatedAt = DateTime.UtcNow;
                savedPrompt = await PromptService.UpdatePromptAsync(prompt);
            }
            else
            {
                prompt.CreatedAt = DateTime.UtcNow;
                prompt.UpdatedAt = DateTime.UtcNow;
                savedPrompt = await PromptService.CreatePromptAsync(prompt);
            }

            await OnSave.InvokeAsync(savedPrompt);
        }
        catch (ArgumentException ex)
        {
            // Handle validation errors specifically
            _tagErrorMessage = ex.Message;
            await OnError.InvokeAsync(ex.Message);
        }
        catch (InvalidOperationException ex)
        {
            // Handle constraint violations and other operational errors
            _tagErrorMessage = ex.Message;
            await OnError.InvokeAsync(ex.Message);
        }
        catch (Exception ex)
        {
            // Handle unexpected errors
            _tagErrorMessage = $"Unexpected error: {ex.Message}";
            await OnError.InvokeAsync(ex.Message);
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
        }
    }

    private async Task HandleCancel()
    {
        await OnCancel.InvokeAsync();
    }

    private void ShowDeleteConfirmation()
    {
        _showDeleteConfirmation = true;
        StateHasChanged();
    }

    private void CancelDelete()
    {
        _showDeleteConfirmation = false;
        StateHasChanged();
    }

    private async Task ConfirmDelete()
    {
        if (ExistingPrompt == null) return;

        try
        {
            _isDeletingPrompt = true;
            StateHasChanged();

            await OnDelete.InvokeAsync(ExistingPrompt);
        }
        catch (Exception ex)
        {
            await OnError.InvokeAsync($"Error deleting prompt: {ex.Message}");
        }
        finally
        {
            _isDeletingPrompt = false;
            _showDeleteConfirmation = false;
            StateHasChanged();
        }
    }

    private string GetDeleteConfirmationMessage()
    {
        if (ExistingPrompt == null) return "Are you sure you want to delete this prompt?";
        return $"Are you sure you want to delete \"{ExistingPrompt.Title}\"? This action cannot be undone.";
    }

    // Form model for validation
    public class PromptFormModel
    {
        public int Id { get; set; }

        [Required(ErrorMessage = "Title is required")]
        [StringLength(200, MinimumLength = 1, ErrorMessage = "Title must be between 1 and 200 characters")]
        [RegularExpression(@"^[^<>""'&]*$", ErrorMessage = "Title contains invalid characters")]
        public string Title { get; set; } = string.Empty;

        [StringLength(500, ErrorMessage = "Description cannot exceed 500 characters")]
        [RegularExpression(@"^[^<>""'&]*$", ErrorMessage = "Description contains invalid characters")]
        public string? Description { get; set; }

        [Required(ErrorMessage = "Content is required")]
        [StringLength(50000, MinimumLength = 1, ErrorMessage = "Content must be between 1 and 50,000 characters")]
        public string Content { get; set; } = string.Empty;

        // Include RowVersion for optimistic concurrency
        public byte[]? RowVersion { get; set; }
    }
}
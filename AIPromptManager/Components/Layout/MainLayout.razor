@using AIPromptManager.Components.Shared
@inherits LayoutComponentBase

<!-- Skip Link -->
<a href="#main-content" 
   class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-blue-600 focus:text-white focus:rounded-md focus:shadow-lg"
   @onclick="SkipToContent">
    Skip to main content
</a>

<div class="h-screen overflow-hidden bg-gray-50">
    <!-- Mobile Navigation Toggle -->
    <button @onclick="ToggleMobileNav" 
            class="fixed top-4 left-4 z-50 lg:hidden p-2 rounded-md bg-white shadow-md border border-gray-200 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
            aria-label="Toggle navigation"
            aria-expanded="@_isMobileNavOpen">
        @if (_isMobileNavOpen)
        {
            <i class="fas fa-times fa-lg text-gray-600" aria-hidden="true"></i>
        }
        else
        {
            <i class="fas fa-bars fa-lg text-gray-600" aria-hidden="true"></i>
        }
    </button>

    <!-- Mobile Overlay -->
    @if (_isMobileNavOpen)
    {
        <div class="fixed inset-0 z-40 bg-black bg-opacity-50 lg:hidden" @onclick="CloseMobileNav" aria-hidden="true"></div>
    }

    <div class="flex h-full">
        <!-- Sidebar -->
        <aside class="@GetSidebarClasses()" role="navigation" aria-label="Main navigation">
            <NavMenu OnNavItemClick="CloseMobileNav" />
        </aside>

        <!-- Main Content -->
        <div class="flex-1 flex flex-col lg:pl-64">
            <!-- Header -->
            <header class="bg-white shadow-sm border-b border-gray-200 flex-shrink-0">
                <div class="px-4 sm:px-6 lg:px-8 py-4">
                    <div class="flex justify-between items-center">
                        <div class="flex items-center">
                            <h1 class="text-xl sm:text-2xl font-semibold text-gray-900 ml-12 lg:ml-0">
                                AI Prompt Manager
                            </h1>
                        </div>
                        <nav class="flex items-center space-x-4" aria-label="Secondary navigation">
                            <LoginDisplay />
                            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank" 
                               class="text-blue-600 hover:text-blue-700 text-sm font-medium transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 rounded-md px-2 py-1">
                                About
                            </a>
                        </nav>
                    </div>
                </div>
            </header>

            <!-- Main Content Area -->
            <main id="main-content" class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8" role="main" tabindex="-1">
                <div class="max-w-7xl mx-auto">
                    @Body
                </div>
            </main>
        </div>
    </div>
</div>

<!-- Toast Container -->
<ToastContainer />

<div id="blazor-error-ui" style="display: none;" data-nosnippet>
    <div class="bg-yellow-50 border-l-4 border-yellow-400 text-yellow-800 p-4 fixed bottom-0 left-0 right-0 z-50" role="alert" aria-live="assertive">
        <div class="flex justify-between items-center">
            <div class="flex items-center">
                <i class="fas fa-exclamation-triangle fa-lg mr-2" aria-hidden="true"></i>
                <span>An unhandled error has occurred.</span>
            </div>
            <div class="flex items-center space-x-2">
                <a href="." class="text-yellow-900 hover:text-yellow-950 font-medium focus:outline-none focus:ring-2 focus:ring-yellow-500 focus:ring-offset-2 rounded px-2 py-1">Reload</a>
                <button class="text-yellow-900 hover:text-yellow-950 font-bold text-lg focus:outline-none focus:ring-2 focus:ring-yellow-500 focus:ring-offset-2 rounded px-1" 
                        onclick="document.getElementById('blazor-error-ui').style.display = 'none'"
                        aria-label="Dismiss error message">×</button>
            </div>
        </div>
    </div>
</div>

@inject IJSRuntime JSRuntime

@code {
    private bool _isMobileNavOpen;

    private void ToggleMobileNav()
    {
        _isMobileNavOpen = !_isMobileNavOpen;
    }

    private void CloseMobileNav()
    {
        _isMobileNavOpen = false;
    }

    private async Task SkipToContent()
    {
        await JSRuntime.InvokeVoidAsync("skipToContent");
    }

    private string GetSidebarClasses()
    {
        var baseClasses = "fixed inset-y-0 left-0 z-40 w-64 bg-white shadow-lg border-r border-gray-200 transform transition-transform duration-300 ease-in-out overflow-y-auto";
        return _isMobileNavOpen 
            ? baseClasses 
            : $"{baseClasses} -translate-x-full lg:translate-x-0";
    }
}

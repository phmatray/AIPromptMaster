<div class="flex flex-col h-full">
    <!-- Logo/Brand Section -->
    <div class="p-6 border-b border-gray-200">
        <a href="" class="flex items-center text-xl font-bold text-blue-600 hover:text-blue-700 transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 rounded-md">
            <svg class="w-8 h-8 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path fill-rule="evenodd" d="M3 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd" />
            </svg>
            <span class="truncate">AI Prompt Manager</span>
        </a>
    </div>

    <!-- Navigation Menu -->
    <nav class="flex-1 p-4" role="navigation" aria-label="Main navigation">
        <ul class="space-y-2" role="list">
            <li role="listitem">
                <NavLink class="@GetNavLinkClasses()" 
                         href="" Match="NavLinkMatch.All"
                         @onclick="HandleNavClick"
                         role="menuitem">
                    <svg class="w-5 h-5 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                        <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"></path>
                    </svg>
                    <span class="truncate">Home</span>
                </NavLink>
            </li>

            <li role="listitem">
                <NavLink class="@GetNavLinkClasses()" 
                         href="prompts"
                         @onclick="HandleNavClick"
                         role="menuitem">
                    <svg class="w-5 h-5 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                        <path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z"></path>
                        <path fill-rule="evenodd" d="M4 5a2 2 0 012-2v1a1 1 0 102 0V3a2 2 0 012 2v6a2 2 0 01-2 2H6a2 2 0 01-2-2V5zm3 2a1 1 0 000 2h.01a1 1 0 100-2H7zm3 0a1 1 0 000 2h3a1 1 0 100-2h-3zm-3 4a1 1 0 100 2h.01a1 1 0 100-2H7zm3 0a1 1 0 100 2h3a1 1 0 100-2h-3z" clip-rule="evenodd"></path>
                    </svg>
                    <span class="truncate">My Prompts</span>
                </NavLink>
            </li>

            <li role="listitem">
                <NavLink class="@GetNavLinkClasses()" 
                         href="create"
                         @onclick="HandleNavClick"
                         role="menuitem">
                    <svg class="w-5 h-5 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                        <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd"></path>
                    </svg>
                    <span class="truncate">Create Prompt</span>
                </NavLink>
            </li>

            <li role="listitem">
                <NavLink class="@GetNavLinkClasses()" 
                         href="search"
                         @onclick="HandleNavClick"
                         role="menuitem">
                    <svg class="w-5 h-5 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                        <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd"></path>
                    </svg>
                    <span class="truncate">Search</span>
                </NavLink>
            </li>

            <li role="listitem">
                <NavLink class="@GetNavLinkClasses()" 
                         href="responsive-test"
                         @onclick="HandleNavClick"
                         role="menuitem">
                    <svg class="w-5 h-5 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                        <path fill-rule="evenodd" d="M3 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd"></path>
                    </svg>
                    <span class="truncate">Responsive Test</span>
                </NavLink>
            </li>
        </ul>
    </nav>

    <!-- Footer Section -->
    <div class="p-4 border-t border-gray-200">
        <div class="text-xs text-gray-500 text-center">
            <p>AI Prompt Manager</p>
            <p class="mt-1">v1.0.0</p>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnNavItemClick { get; set; }

    private async Task HandleNavClick()
    {
        await OnNavItemClick.InvokeAsync();
    }

    private string GetNavLinkClasses()
    {
        return "flex items-center w-full px-3 py-2 text-gray-700 rounded-lg hover:bg-gray-100 focus:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-colors duration-200 group";
    }
}


<div class="flex flex-col h-full">
    <!-- Logo/Brand Section -->
    <div class="p-6 border-b border-gray-200">
        <a href="" class="flex items-center text-xl font-bold text-blue-600 hover:text-blue-700 transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 rounded-md">
            <i class="fas fa-layer-group fa-2x mr-3 flex-shrink-0" aria-hidden="true"></i>
            <span class="truncate">AI Prompt Manager</span>
        </a>
    </div>

    <!-- Navigation Menu -->
    <nav class="flex-1 p-4" role="navigation" aria-label="Main navigation">
        <ul class="space-y-2" role="list">
            <li role="listitem">
                <NavLink class="@GetNavLinkClasses()" 
                         href="" Match="NavLinkMatch.All"
                         @onclick="HandleNavClick"
                         role="menuitem">
                    <i class="fas fa-home fa-lg mr-3 flex-shrink-0" aria-hidden="true"></i>
                    <span class="truncate">Home</span>
                </NavLink>
            </li>

            <li role="listitem">
                <NavLink class="@GetNavLinkClasses()" 
                         href="prompts"
                         @onclick="HandleNavClick"
                         role="menuitem">
                    <i class="fas fa-list-alt fa-lg mr-3 flex-shrink-0" aria-hidden="true"></i>
                    <span class="truncate">My Prompts</span>
                </NavLink>
            </li>

            <li role="listitem">
                <NavLink class="@GetNavLinkClasses()" 
                         href="create"
                         @onclick="HandleNavClick"
                         role="menuitem">
                    <i class="fas fa-plus-circle fa-lg mr-3 flex-shrink-0" aria-hidden="true"></i>
                    <span class="truncate">Create Prompt</span>
                </NavLink>
            </li>

            <li role="listitem">
                <NavLink class="@GetNavLinkClasses()" 
                         href="search"
                         @onclick="HandleNavClick"
                         role="menuitem">
                    <i class="fas fa-search fa-lg mr-3 flex-shrink-0" aria-hidden="true"></i>
                    <span class="truncate">Search</span>
                </NavLink>
            </li>

            <li role="listitem">
                <NavLink class="@GetNavLinkClasses()" 
                         href="performance"
                         @onclick="HandleNavClick"
                         role="menuitem">
                    <i class="fas fa-tachometer-alt fa-lg mr-3 flex-shrink-0" aria-hidden="true"></i>
                    <span class="truncate">Performance</span>
                </NavLink>
            </li>

            <li role="listitem">
                <NavLink class="@GetNavLinkClasses()" 
                         href="responsive-test"
                         @onclick="HandleNavClick"
                         role="menuitem">
                    <i class="fas fa-mobile-alt fa-lg mr-3 flex-shrink-0" aria-hidden="true"></i>
                    <span class="truncate">Responsive Test</span>
                </NavLink>
            </li>
        </ul>
    </nav>

    <!-- Footer Section -->
    <div class="p-4 border-t border-gray-200">
        <div class="text-xs text-gray-500 text-center">
            <p>AI Prompt Manager</p>
            <p class="mt-1">v1.0.0</p>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnNavItemClick { get; set; }

    private async Task HandleNavClick()
    {
        await OnNavItemClick.InvokeAsync();
    }

    private string GetNavLinkClasses()
    {
        return "flex items-center w-full px-3 py-2 text-gray-700 rounded-lg hover:bg-gray-100 focus:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-colors duration-200 group";
    }
}

